#!/usr/bin/env python3
"""Cachy Console — pick the one display gamescope will always use.

Search for "Cachy Console" in the app menu. Saves a connector name (HDMI-1),
not "whatever screen is on". Changing the display while console mode is already
running does not move the live session; exit first, then press the Steam button
twice so the next session uses the new screen.
"""

import importlib.machinery
import importlib.util
import os
import subprocess
import sys

APP_NAME = "Cachy Console"
APP_ID = "io.cachyos.CachyConsole"

HERE = os.path.dirname(os.path.abspath(__file__))
loader = importlib.machinery.SourceFileLoader(
    "ccd", os.path.join(HERE, "cachy-console-display"))
spec = importlib.util.spec_from_loader("ccd", loader)
ccd = importlib.util.module_from_spec(spec)
loader.exec_module(ccd)


def snapshot():
    """Currently connected displays plus the saved target, even if it is off."""
    try:
        found = ccd.displays()
    except ccd.DisplayError:
        found = []
    rows = []
    seen = set()
    for display in found:
        connector = ccd.connector_of(display)
        seen.add(connector.lower())
        rows.append({
            "connector": connector,
            "model": display.get("model") or display["name"],
            "mode": f"{display['w']}x{display['h']}@{display['refresh']}Hz",
            "connected": True,
        })
    saved = ccd.saved_connector()
    model = (ccd.read_config().get("DISPLAY_MODEL") or "").strip()
    if saved and saved.lower() not in seen:
        rows.append({
            "connector": saved,
            "model": model or saved,
            "mode": "currently off",
            "connected": False,
        })
    return rows, saved


def save_connector(connector, model=""):
    ccd.update_config({"DISPLAY": connector, "DISPLAY_MODEL": model})


def console_running():
    """True if a gamescope compositor is up (console mode is live)."""
    try:
        return subprocess.run(
            ["pgrep", "-x", "gamescope-wl"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except OSError:
        return False


def apply_message(connector):
    if console_running():
        return (f"Saved {connector}. Console mode is still on the old display. "
                "Exit with cachy-console exit (or Exit Console Mode in the "
                "library), then press the Steam button twice to open it on "
                f"{connector}.")
    return (f"Saved {connector}. Press the Steam button twice to open console "
            "mode on this display.")


HINT = (
    "Only this display is used. If you turn it off, the Steam button waits "
    "for it — it will not move Big Picture onto another screen.\n\n"
    "To change display while already in console mode: save here, exit back "
    "to the desktop, then press the Steam button twice."
)


def run_gtk():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, Gtk

    class Window(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title=APP_NAME)
            self.set_default_size(520, 460)
            self.set_border_width(16)
            self.choice = None
            self.choice_model = ""

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            self.add(box)

            title = Gtk.Label()
            title.set_markup(f"<b>{APP_NAME}</b> — which display should console mode use?")
            title.set_xalign(0)
            box.pack_start(title, False, False, 0)

            hint = Gtk.Label(label=HINT)
            hint.set_line_wrap(True)
            hint.set_xalign(0)
            hint.set_max_width_chars(56)
            box.pack_start(hint, False, False, 0)

            self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.list_box, True, True, 0)

            self.status = Gtk.Label()
            self.status.set_line_wrap(True)
            self.status.set_xalign(0)
            self.status.set_max_width_chars(56)
            box.pack_start(self.status, False, False, 0)

            buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            refresh = Gtk.Button(label="Refresh")
            refresh.connect("clicked", lambda *_: self.reload())
            save = Gtk.Button(label="Save")
            save.get_style_context().add_class("suggested-action")
            save.connect("clicked", self.on_save)
            buttons.pack_end(save, False, False, 0)
            buttons.pack_end(refresh, False, False, 0)
            box.pack_end(buttons, False, False, 0)
            self.reload()

        def reload(self):
            for child in list(self.list_box.get_children()):
                self.list_box.remove(child)
            rows, saved = snapshot()
            if not rows:
                self.list_box.pack_start(
                    Gtk.Label(label="No displays detected."), True, True, 0)
                self.choice = None
                self.show_all()
                return
            group = None
            self.choice = saved
            for row in rows:
                label = f"{row['connector']}  —  {row['model']}  ({row['mode']})"
                radio = Gtk.RadioButton.new_with_label_from_widget(group, label)
                if group is None:
                    group = radio
                radio.connector = row["connector"]
                radio.model = row["model"]
                if saved and row["connector"].lower() == saved.lower():
                    radio.set_active(True)
                    self.choice = row["connector"]
                    self.choice_model = row["model"]
                radio.connect("toggled", self.on_toggle, row)
                self.list_box.pack_start(radio, False, False, 0)
            if saved:
                extra = " Console mode is running on the previous display." if console_running() else ""
                self.status.set_text(f"Saved: {saved}.{extra}")
            else:
                self.status.set_text("Nothing saved yet. Pick a display and click Save.")
            self.show_all()

        def on_toggle(self, radio, row):
            if radio.get_active():
                self.choice = row["connector"]
                self.choice_model = row["model"]

        def on_save(self, _button):
            if not self.choice:
                self.status.set_text("Pick a display first.")
                return
            model = self.choice_model
            for child in self.list_box.get_children():
                if isinstance(child, Gtk.RadioButton) and child.get_active():
                    model = getattr(child, "model", model)
                    self.choice = child.connector
            save_connector(self.choice, model)
            self.status.set_text(apply_message(self.choice))
            self.reload()

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(
                application_id=APP_ID,
                flags=Gio.ApplicationFlags.FLAGS_NONE)
            self.win = None

        def do_activate(self):
            if self.win is None:
                self.win = Window(self)
                self.win.connect("destroy", self._on_destroy)
            self.win.present()
            self.win.show_all()

        def _on_destroy(self, _win):
            self.win = None

    return App().run(sys.argv)


def run_tk():
    import tkinter as tk
    from tkinter import ttk

    root = tk.Tk()
    root.title(APP_NAME)
    root.minsize(500, 400)
    var = tk.StringVar()
    status = tk.StringVar()
    frame = ttk.Frame(root, padding=16)
    frame.pack(fill="both", expand=True)
    ttk.Label(frame, text=f"{APP_NAME} — which display should console mode use?",
              font=("", 12, "bold")).pack(anchor="w")
    ttk.Label(frame, text=HINT, wraplength=460, justify="left").pack(
        anchor="w", pady=(4, 12))
    radios = ttk.Frame(frame)
    radios.pack(fill="both", expand=True)

    def reload():
        for child in radios.winfo_children():
            child.destroy()
        rows, saved = snapshot()
        if saved:
            var.set(saved)
            extra = " Console mode is running on the previous display." if console_running() else ""
            status.set(f"Saved: {saved}.{extra}")
        else:
            var.set("")
            status.set("Nothing saved yet. Pick a display and click Save.")
        if not rows:
            ttk.Label(radios, text="No displays detected.").pack(anchor="w")
            return
        for row in rows:
            text = f"{row['connector']}  —  {row['model']}  ({row['mode']})"
            ttk.Radiobutton(radios, text=text, value=row["connector"],
                            variable=var).pack(anchor="w", pady=2)

    def on_save():
        connector = var.get().strip()
        if not connector:
            status.set("Pick a display first.")
            return
        model = ""
        for row in snapshot()[0]:
            if row["connector"] == connector:
                model = row["model"]
                break
        save_connector(connector, model)
        status.set(apply_message(connector))
        reload()

    ttk.Label(frame, textvariable=status, wraplength=460, justify="left").pack(
        anchor="w", pady=(8, 8))
    btns = ttk.Frame(frame)
    btns.pack(fill="x")
    ttk.Button(btns, text="Refresh", command=reload).pack(side="right")
    ttk.Button(btns, text="Save", command=on_save).pack(side="right", padx=8)
    reload()
    root.mainloop()
    return 0


def main():
    try:
        return run_gtk()
    except Exception:
        try:
            return run_tk()
        except Exception as exc:
            print(f"{APP_NAME}: cannot open a window ({exc})", file=sys.stderr)
            print("Pick a display from the terminal instead:", file=sys.stderr)
            print("  cachy-console displays", file=sys.stderr)
            print("  cachy-console-display set HDMI-1", file=sys.stderr)
            return 1


if __name__ == "__main__":
    sys.exit(main())
