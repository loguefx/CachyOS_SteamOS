#!/usr/bin/env python3
"""Cachy Console — pick the display and audio gamescope will always use.

Search for "Cachy Console" in the app menu. Saves a connector name (HDMI-1)
and an audio output (Optoma UHD, a headset, …). Changing the display while
console mode is already running does not move the live session; exit first,
then press the Steam button twice. Changing audio is applied immediately if
console mode is already running, and is kept until you pick a different output.
"""

import importlib.machinery
import importlib.util
import os
import subprocess
import sys

APP_NAME = "Cachy Console"
APP_ID = "io.cachyos.CachyConsole"

HERE = os.path.dirname(os.path.abspath(__file__))
loader = importlib.machinery.SourceFileLoader(
    "ccd", os.path.join(HERE, "cachy-console-display"))
spec = importlib.util.spec_from_loader("ccd", loader)
ccd = importlib.util.module_from_spec(spec)
loader.exec_module(ccd)

pads_loader = importlib.machinery.SourceFileLoader(
    "ccpads", os.path.join(HERE, "cachy-console-pads"))
pads_spec = importlib.util.spec_from_loader("ccpads", pads_loader)
pads = importlib.util.module_from_spec(pads_spec)
pads_loader.exec_module(pads)


def snapshot():
    """Currently connected displays plus the saved target, even if it is off."""
    try:
        found = ccd.displays()
    except ccd.DisplayError:
        found = []
    rows = []
    seen = set()
    for display in found:
        connector = ccd.connector_of(display)
        seen.add(ccd.normalize_connector(connector))
        rows.append({
            "connector": connector,
            "model": display.get("model") or display["name"],
            "mode": f"{display['w']}x{display['h']}@{display['refresh']}Hz",
            "connected": True,
        })
    saved = ccd.saved_connector()
    model = (ccd.read_config().get("DISPLAY_MODEL") or "").strip()
    if saved and ccd.normalize_connector(saved) not in seen:
        rows.append({
            "connector": saved,
            "model": model or saved,
            "mode": "currently off",
            "connected": False,
        })
    return rows, saved


def save_connector(connector, model=""):
    ccd.update_config({"DISPLAY": connector, "DISPLAY_MODEL": model})


def save_audio(device):
    ccd.update_config({"AUDIO_DEVICE": device})


def save_audio_input(device):
    ccd.update_config({"AUDIO_INPUT_DEVICE": device})


def saved_primary():
    return pads.normalize(ccd.read_config().get("PRIMARY_CONTROLLER")) or pads.DEFAULT


def save_primary(kind):
    ccd.update_config({"PRIMARY_CONTROLLER": kind})


def primary_label(kind):
    return dict(pads.CHOICES).get(kind, kind)


def snapshot_input():
    """Microphones, plus the saved one ("" means the session default)."""
    return ccd.audio_input_choices(), ccd.saved_audio_input_device() or ""


def snapshot_audio():
    """HDMI monitors and other sinks, plus the saved (or suggested) output."""
    rows = ccd.audio_choices()
    saved = ccd.saved_audio_device() or ""
    if not saved:
        hit = ccd.match_hdmi()
        if hit and hit.get("eld"):
            saved = hit["eld"]
    return rows, saved


def apply_audio_now():
    helper = os.path.join(HERE, "cachy-console-display")
    try:
        subprocess.run(
            [helper, "audio-route"], timeout=15,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except (OSError, subprocess.TimeoutExpired):
        return False


def console_running():
    """True if a gamescope compositor is up (console mode is live)."""
    try:
        return subprocess.run(
            ["pgrep", "-x", "gamescope-wl"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except OSError:
        return False


def apply_message(connector, audio="", audio_applied=False, mic=""):
    extra = f" Audio: {audio}." if audio else ""
    if mic:
        extra += f" Mic: {mic}."
    if console_running():
        live = " Audio is switched now." if audio_applied else ""
        # The mic is an environment variable handed to what console mode starts,
        # so a running session keeps the one it was given.
        later = " The microphone applies to the next session." if mic else ""
        return (f"Saved {connector}.{extra}{live}{later} Console mode is still "
                "on the old display. Exit with cachy-console exit (or Exit "
                "Console Mode in the library), then press the Steam button "
                f"twice to open it on {connector}.")
    return (f"Saved {connector}.{extra} Press the Steam button twice to open "
            "console mode on this display.")


HINT = (
    "Only this display is used. If you turn it off, the Steam button waits "
    "for it — it will not move Big Picture onto another screen.\n\n"
    "To change display while already in console mode: save here, exit back "
    "to the desktop, then press the Steam button twice."
)

AUDIO_HINT = (
    "Console mode plays through this output until you pick a different one. "
    "HDMI monitors share one GPU audio device, so picking the projector "
    "moves TV/monitor HDMI audio onto that screen for the session."
)

INPUT_HINT = (
    "Voice chat from the couch uses this microphone. It is handed only to what "
    "console mode launches, so your desktop's own default input is left alone. "
    "A change takes effect the next time console mode starts."
)

DEFAULT_INPUT_LABEL = "Session default (leave input alone)"

PRIMARY_HINT = (
    "With more than one controller connected, this one is player one — the "
    "one a single-player game listens to. Steam otherwise gives player one to "
    "whichever controller it saw first, which is usually a DualSense. "
    "PlayStation controllers go through Steam Input during console mode so they "
    "can be ordered. A change takes effect the next time console mode starts."
)


def run_gtk():
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, Gtk

    class Window(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title=APP_NAME)
            self.set_default_size(560, 720)
            self.set_border_width(16)
            self.choice = None
            self.choice_model = ""
            self.choice_audio = ""
            self.choice_input = ""

            # Three groups of radios do not fit every screen, and Save has to
            # stay reachable, so only the choices scroll.
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            self.add(outer)
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            outer.pack_start(scroller, True, True, 0)

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            scroller.add(box)

            title = Gtk.Label()
            title.set_markup(f"<b>{APP_NAME}</b> — which display should console mode use?")
            title.set_xalign(0)
            box.pack_start(title, False, False, 0)

            hint = Gtk.Label(label=HINT)
            hint.set_line_wrap(True)
            hint.set_xalign(0)
            hint.set_max_width_chars(56)
            box.pack_start(hint, False, False, 0)

            self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.list_box, True, True, 0)

            audio_title = Gtk.Label()
            audio_title.set_markup("<b>Audio output</b>")
            audio_title.set_xalign(0)
            box.pack_start(audio_title, False, False, 0)

            audio_hint = Gtk.Label(label=AUDIO_HINT)
            audio_hint.set_line_wrap(True)
            audio_hint.set_xalign(0)
            audio_hint.set_max_width_chars(56)
            box.pack_start(audio_hint, False, False, 0)

            self.audio_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.audio_box, True, True, 0)

            input_title = Gtk.Label()
            input_title.set_markup("<b>Microphone</b>")
            input_title.set_xalign(0)
            box.pack_start(input_title, False, False, 0)

            input_hint = Gtk.Label(label=INPUT_HINT)
            input_hint.set_line_wrap(True)
            input_hint.set_xalign(0)
            input_hint.set_max_width_chars(56)
            box.pack_start(input_hint, False, False, 0)

            self.input_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.input_box, True, True, 0)

            primary_title = Gtk.Label()
            primary_title.set_markup("<b>Player one</b>")
            primary_title.set_xalign(0)
            box.pack_start(primary_title, False, False, 0)

            primary_hint = Gtk.Label(label=PRIMARY_HINT)
            primary_hint.set_line_wrap(True)
            primary_hint.set_xalign(0)
            primary_hint.set_max_width_chars(56)
            box.pack_start(primary_hint, False, False, 0)

            self.primary_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.primary_box, True, True, 0)

            self.status = Gtk.Label()
            self.status.set_line_wrap(True)
            self.status.set_xalign(0)
            self.status.set_max_width_chars(56)
            outer.pack_start(self.status, False, False, 0)

            buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            refresh = Gtk.Button(label="Refresh")
            refresh.connect("clicked", lambda *_: self.reload())
            save = Gtk.Button(label="Save")
            save.get_style_context().add_class("suggested-action")
            save.connect("clicked", self.on_save)
            buttons.pack_end(save, False, False, 0)
            buttons.pack_end(refresh, False, False, 0)
            outer.pack_end(buttons, False, False, 0)
            self.reload()

        def reload(self):
            for child in list(self.list_box.get_children()):
                self.list_box.remove(child)
            for child in list(self.audio_box.get_children()):
                self.audio_box.remove(child)
            for child in list(self.input_box.get_children()):
                self.input_box.remove(child)
            rows, saved = snapshot()
            audio_rows, saved_audio = snapshot_audio()
            input_rows, saved_input = snapshot_input()
            self.choice_audio = saved_audio
            self.choice_input = saved_input
            if not rows:
                self.list_box.pack_start(
                    Gtk.Label(label="No displays detected."), True, True, 0)
                self.choice = None
            else:
                group = None
                self.choice = saved
                for row in rows:
                    label = f"{row['connector']}  —  {row['model']}  ({row['mode']})"
                    radio = Gtk.RadioButton.new_with_label_from_widget(group, label)
                    if group is None:
                        group = radio
                    radio.connector = row["connector"]
                    radio.model = row["model"]
                    if saved and ccd.connectors_match(row["connector"], saved):
                        radio.set_active(True)
                        self.choice = row["connector"]
                        self.choice_model = row["model"]
                    radio.connect("toggled", self.on_toggle, row)
                    self.list_box.pack_start(radio, False, False, 0)
            if not audio_rows:
                self.audio_box.pack_start(
                    Gtk.Label(label="No audio devices detected."), True, True, 0)
            else:
                group = None
                for row in audio_rows:
                    label = f"{row['label']}  ({row['detail']})"
                    radio = Gtk.RadioButton.new_with_label_from_widget(group, label)
                    if group is None:
                        group = radio
                    radio.audio_id = row["id"]
                    if saved_audio and row["id"].lower() == saved_audio.lower():
                        radio.set_active(True)
                        self.choice_audio = row["id"]
                    radio.connect("toggled", self.on_audio_toggle, row)
                    self.audio_box.pack_start(radio, False, False, 0)

            # Always offered, so there is a way back to not touching input.
            group = Gtk.RadioButton.new_with_label_from_widget(
                None, DEFAULT_INPUT_LABEL)
            group.audio_input = ""
            group.set_active(not saved_input)
            group.connect("toggled", self.on_input_toggle, {"id": ""})
            self.input_box.pack_start(group, False, False, 0)
            for row in input_rows:
                label = f"{row['label']}  ({row['detail']})"
                radio = Gtk.RadioButton.new_with_label_from_widget(group, label)
                radio.audio_input = row["id"]
                if saved_input and row["id"].lower() == saved_input.lower():
                    radio.set_active(True)
                    self.choice_input = row["id"]
                radio.connect("toggled", self.on_input_toggle, row)
                self.input_box.pack_start(radio, False, False, 0)

            for child in list(self.primary_box.get_children()):
                self.primary_box.remove(child)
            saved_kind = saved_primary()
            group = None
            for kind, label in pads.CHOICES:
                radio = Gtk.RadioButton.new_with_label_from_widget(group, label)
                if group is None:
                    group = radio
                radio.primary = kind
                radio.set_active(kind == saved_kind)
                self.primary_box.pack_start(radio, False, False, 0)

            if saved:
                extra = " Console mode is running on the previous display." if console_running() else ""
                audio = f" Audio: {saved_audio}." if saved_audio else ""
                mic = f" Mic: {saved_input}." if saved_input else ""
                self.status.set_text(f"Saved: {saved}.{audio}{mic}{extra}")
            else:
                self.status.set_text("Nothing saved yet. Pick a display and click Save.")
            self.show_all()

        def on_toggle(self, radio, row):
            if radio.get_active():
                self.choice = row["connector"]
                self.choice_model = row["model"]

        def on_audio_toggle(self, radio, row):
            if radio.get_active():
                self.choice_audio = row["id"]

        def on_input_toggle(self, radio, row):
            if radio.get_active():
                self.choice_input = row["id"]

        def on_save(self, _button):
            if not self.choice:
                self.status.set_text("Pick a display first.")
                return
            model = self.choice_model
            for child in self.list_box.get_children():
                if isinstance(child, Gtk.RadioButton) and child.get_active():
                    model = getattr(child, "model", model)
                    self.choice = child.connector
            audio = self.choice_audio
            for child in self.audio_box.get_children():
                if isinstance(child, Gtk.RadioButton) and child.get_active():
                    audio = getattr(child, "audio_id", audio)
                    self.choice_audio = audio
            mic = self.choice_input
            for child in self.input_box.get_children():
                if isinstance(child, Gtk.RadioButton) and child.get_active():
                    mic = getattr(child, "audio_input", mic)
                    self.choice_input = mic
            primary = saved_primary()
            for child in self.primary_box.get_children():
                if isinstance(child, Gtk.RadioButton) and child.get_active():
                    primary = child.primary
            save_connector(self.choice, model)
            if audio:
                save_audio(audio)
            # Written even when empty: that is how the session default is chosen.
            save_audio_input(mic)
            save_primary(primary)
            applied = False
            if audio and console_running():
                applied = apply_audio_now()
            self.reload()
            self.status.set_text(apply_message(self.choice, audio, applied, mic)
                                 + f" Player one: {primary_label(primary)}.")

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(
                application_id=APP_ID,
                flags=Gio.ApplicationFlags.FLAGS_NONE)
            self.win = None

        def do_activate(self):
            if self.win is None:
                self.win = Window(self)
                self.win.connect("destroy", self._on_destroy)
            else:
                # Opening the application again lands here rather than in a second
                # process, and the window it raises may have been sitting open
                # since before the television was turned on or the headset
                # plugged in. Its lists are from whenever it was built, and a
                # choice saved from a stale list is a device that no longer means
                # what it did -- so it is read again on the way to the front.
                self.win.reload()
            self.win.present()
            self.win.show_all()

        def _on_destroy(self, _win):
            self.win = None

    return App().run(sys.argv)


def run_tk():
    import tkinter as tk
    from tkinter import ttk

    root = tk.Tk()
    root.title(APP_NAME)
    root.minsize(520, 680)
    var = tk.StringVar()
    audio_var = tk.StringVar()
    input_var = tk.StringVar()
    status = tk.StringVar()
    frame = ttk.Frame(root, padding=16)
    frame.pack(fill="both", expand=True)
    ttk.Label(frame, text=f"{APP_NAME} — which display should console mode use?",
              font=("", 12, "bold")).pack(anchor="w")
    ttk.Label(frame, text=HINT, wraplength=460, justify="left").pack(
        anchor="w", pady=(4, 12))
    radios = ttk.Frame(frame)
    radios.pack(fill="both", expand=True)
    ttk.Label(frame, text="Audio output", font=("", 12, "bold")).pack(
        anchor="w", pady=(8, 0))
    ttk.Label(frame, text=AUDIO_HINT, wraplength=460, justify="left").pack(
        anchor="w", pady=(4, 8))
    audio_radios = ttk.Frame(frame)
    audio_radios.pack(fill="both", expand=True)
    ttk.Label(frame, text="Microphone", font=("", 12, "bold")).pack(
        anchor="w", pady=(8, 0))
    ttk.Label(frame, text=INPUT_HINT, wraplength=460, justify="left").pack(
        anchor="w", pady=(4, 8))
    input_radios = ttk.Frame(frame)
    input_radios.pack(fill="both", expand=True)
    primary_var = tk.StringVar()
    ttk.Label(frame, text="Player one", font=("", 12, "bold")).pack(
        anchor="w", pady=(8, 0))
    ttk.Label(frame, text=PRIMARY_HINT, wraplength=460, justify="left").pack(
        anchor="w", pady=(4, 8))
    primary_radios = ttk.Frame(frame)
    primary_radios.pack(fill="both", expand=True)
    for kind, label in pads.CHOICES:
        ttk.Radiobutton(primary_radios, text=label, value=kind,
                        variable=primary_var).pack(anchor="w", pady=2)

    def reload():
        primary_var.set(saved_primary())
        for child in radios.winfo_children():
            child.destroy()
        for child in audio_radios.winfo_children():
            child.destroy()
        for child in input_radios.winfo_children():
            child.destroy()
        rows, saved = snapshot()
        audio_rows, saved_audio = snapshot_audio()
        input_rows, saved_input = snapshot_input()
        if saved:
            var.set(saved)
            for row in rows:
                if ccd.connectors_match(row["connector"], saved):
                    var.set(row["connector"])
                    break
            extra = " Console mode is running on the previous display." if console_running() else ""
            audio = f" Audio: {saved_audio}." if saved_audio else ""
            mic = f" Mic: {saved_input}." if saved_input else ""
            status.set(f"Saved: {saved}.{audio}{mic}{extra}")
        else:
            var.set("")
            status.set("Nothing saved yet. Pick a display and click Save.")
        audio_var.set(saved_audio or "")
        input_var.set(saved_input or "")
        if not rows:
            ttk.Label(radios, text="No displays detected.").pack(anchor="w")
        else:
            for row in rows:
                text = f"{row['connector']}  —  {row['model']}  ({row['mode']})"
                ttk.Radiobutton(radios, text=text, value=row["connector"],
                                variable=var).pack(anchor="w", pady=2)
        if not audio_rows:
            ttk.Label(audio_radios, text="No audio devices detected.").pack(anchor="w")
        else:
            for row in audio_rows:
                text = f"{row['label']}  ({row['detail']})"
                ttk.Radiobutton(audio_radios, text=text, value=row["id"],
                                variable=audio_var).pack(anchor="w", pady=2)
        # Always offered, so there is a way back to not touching input.
        ttk.Radiobutton(input_radios, text=DEFAULT_INPUT_LABEL, value="",
                        variable=input_var).pack(anchor="w", pady=2)
        for row in input_rows:
            text = f"{row['label']}  ({row['detail']})"
            ttk.Radiobutton(input_radios, text=text, value=row["id"],
                            variable=input_var).pack(anchor="w", pady=2)

    def on_save():
        connector = var.get().strip()
        if not connector:
            status.set("Pick a display first.")
            return
        model = ""
        for row in snapshot()[0]:
            if row["connector"] == connector:
                model = row["model"]
                break
        audio = audio_var.get().strip()
        mic = input_var.get().strip()
        save_connector(connector, model)
        if audio:
            save_audio(audio)
        # Written even when empty: that is how the session default is chosen.
        save_audio_input(mic)
        primary = pads.normalize(primary_var.get()) or pads.DEFAULT
        save_primary(primary)
        applied = bool(audio and console_running() and apply_audio_now())
        reload()
        status.set(apply_message(connector, audio, applied, mic)
                   + f" Player one: {primary_label(primary)}.")

    ttk.Label(frame, textvariable=status, wraplength=460, justify="left").pack(
        anchor="w", pady=(8, 8))
    btns = ttk.Frame(frame)
    btns.pack(fill="x")
    ttk.Button(btns, text="Refresh", command=reload).pack(side="right")
    ttk.Button(btns, text="Save", command=on_save).pack(side="right", padx=8)
    reload()
    root.mainloop()
    return 0


def main():
    try:
        return run_gtk()
    except Exception:
        try:
            return run_tk()
        except Exception as exc:
            print(f"{APP_NAME}: cannot open a window ({exc})", file=sys.stderr)
            print("Pick a display from the terminal instead:", file=sys.stderr)
            print("  cachy-console displays", file=sys.stderr)
            print("  cachy-console-display set HDMI-1", file=sys.stderr)
            return 1


if __name__ == "__main__":
    sys.exit(main())
