#!/usr/bin/env python3
"""Add an "Exit Console Mode" entry to Steam's library as a non-Steam shortcut.

Big Picture offers no usable way out of a gamescope session it did not start
itself: Steam hides "Exit Steam", "Exit Big Picture Mode" and "Minimize" while
it detects gamescope, and "Switch to Desktop" calls a SteamOS-only method that
the ordinary Linux client answers with "not implemented". A library entry is
reachable with a controller and owes nothing to Steam's menus, so it is an exit
that no client update can take away.

The entry runs `cachy-console-exit`, which stops gamescope; Steam is its child,
so the desktop comes back and cachy-console-watch restarts the desktop client.

Steam rewrites shortcuts.vdf from memory when it shuts down, so it must not be
running while we edit the file, or our entry is silently discarded.

The same machinery adds any other program you want to reach from the couch,
which is how Discord gets into console mode -- gamescope cannot adopt a window
owned by your desktop, so it has to be started inside the session:

    cachy-console shortcut --name Discord --exe /usr/bin/discord

Such an entry is launched through cachy-console-app rather than directly,
because a desktop application dropped into a Steam library needs two things
Steam will not do for it: the copy already running on the desktop has to be
quit, or the new one hands its window to that copy and exits as a secondary
instance, and the application has to be quit for real once its window closes,
since a session with no tray cannot bring back something that merely hid
itself. That goes in the tile's launch options rather than replacing its Exe,
so the appid Steam derives from the path does not move and anything keyed to it
-- an AUDIO_NEVER_MUTE entry, a controller layout, the artwork below -- keeps
matching. The exit tile is never wrapped: it opens no window and is meant to
return immediately.

Usage:
    cachy-console shortcut [--dry-run] [--revert] [--force] [--no-wrap]
                           [--name NAME] [--exe PATH]
                           [--icon PATH] [--no-art]
"""

import argparse
import importlib.machinery
import importlib.util
import os
import shutil
import struct
import subprocess
import sys
import time
import zlib

# Library artwork lives in its own helper because it is the only part of this
# tool that wants an imaging library, and a machine without Pillow must still
# be able to add the exit tile.
try:
    _ART = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "cachy-console-art")
    _loader = importlib.machinery.SourceFileLoader("cca", _ART)
    artwork = importlib.util.module_from_spec(
        importlib.util.spec_from_loader("cca", _loader))
    _loader.exec_module(artwork)
except (OSError, ImportError):
    artwork = None

MAP_START, STRING, INT32, MAP_END = 0x00, 0x01, 0x02, 0x08

DEFAULT_NAME = "Exit Console Mode"
STEAM_ROOT = os.path.expanduser("~/.steam/steam")


class VDFError(Exception):
    pass


def read_cstring(data, i):
    end = data.find(b"\x00", i)
    if end < 0:
        raise VDFError(f"unterminated string at byte {i}")
    return data[i:end].decode("utf-8", "replace"), end + 1


def parse_map(data, i, root=False):
    """Parse one binary-KeyValues map, returning it and the offset after it.

    The outermost map is implicit and its terminator is the last byte of the
    file, so at the root a clean end-of-data is the end of the map rather than
    truncation.
    """
    out = {}
    while True:
        if i >= len(data):
            if root:
                return out, i
            raise VDFError("file ended inside a map")
        kind = data[i]
        i += 1
        if kind == MAP_END:
            return out, i
        key, i = read_cstring(data, i)
        if kind == MAP_START:
            out[key], i = parse_map(data, i)
        elif kind == STRING:
            out[key], i = read_cstring(data, i)
        elif kind == INT32:
            if i + 4 > len(data):
                raise VDFError(f"truncated int for key {key!r}")
            out[key] = struct.unpack_from("<I", data, i)[0]
            i += 4
        else:
            raise VDFError(f"unknown type byte 0x{kind:02x} for key {key!r}")


def parse(data):
    if not data:
        return {}
    obj, _ = parse_map(data, 0, root=True)
    return obj


def serialize(obj):
    out = bytearray()
    for key, value in obj.items():
        name = key.encode("utf-8") + b"\x00"
        if isinstance(value, dict):
            out += bytes([MAP_START]) + name + serialize(value) + bytes([MAP_END])
        elif isinstance(value, bool):
            out += bytes([INT32]) + name + struct.pack("<I", int(value))
        elif isinstance(value, int):
            # Unsigned: shortcut appids have the high bit set.
            out += bytes([INT32]) + name + struct.pack("<I", value & 0xFFFFFFFF)
        else:
            out += bytes([STRING]) + name + str(value).encode("utf-8") + b"\x00"
    return bytes(out)


def dumps(obj):
    """Serialize a whole file, including the implicit root map's terminator."""
    return serialize(obj) + bytes([MAP_END])


def shortcut_appid(exe, name):
    """The id Steam derives for a non-Steam shortcut: crc32, high bit set."""
    return zlib.crc32((exe + name).encode("utf-8")) | 0x80000000


def sibling(name):
    """Where one of our own helpers lives.

    Steam stores an absolute path in shortcuts.vdf and launches it with its own
    environment, so this has to be resolved now rather than left to a PATH that
    Steam may not share.
    """
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    if os.access(here, os.X_OK):
        return here
    found = shutil.which(name)
    if found:
        return found
    return os.path.expanduser(f"~/.local/bin/{name}")


def default_exe():
    return sibling("cachy-console-exit")


def steam_running():
    try:
        subprocess.run(["pgrep", "-x", "steam"], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def config_paths():
    base = os.path.join(STEAM_ROOT, "userdata")
    if not os.path.isdir(base):
        return []
    found = []
    for entry in sorted(os.listdir(base)):
        if not entry.isdigit() or entry == "0":
            continue          # "0" is the anonymous/logged-out profile
        cfg = os.path.join(base, entry, "config")
        if os.path.isdir(cfg):
            found.append(os.path.join(cfg, "shortcuts.vdf"))
    return found


def load(path):
    if not os.path.exists(path):
        return {"shortcuts": {}}
    with open(path, "rb") as fh:
        data = fh.read()
    obj = parse(data)
    obj.setdefault("shortcuts", {})
    return obj


def save(path, obj, dry_run):
    payload = dumps(obj)
    if dry_run:
        print(f"  would write {len(payload)} bytes to {path}")
        return
    if os.path.exists(path):
        backup = f"{path}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(path, backup)
        print(f"  backed up existing file to {os.path.basename(backup)}")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "wb") as fh:
        fh.write(payload)
    os.replace(tmp, path)     # atomic, so a crash cannot truncate the library
    print(f"  wrote {len(payload)} bytes to {path}")


# Older installs used the personal projector scripts. The library tile still
# says "Exit Game Mode" and points at projector-exit; treat that as this entry.
LEGACY_NAMES = ("Exit Game Mode", "Exit Console Mode", DEFAULT_NAME)
LEGACY_EXE_MARKERS = ("projector-exit", "cachy-console-exit")


def manages_exit_entry(exe, name):
    """Whether this run is about the exit tile rather than some other program.

    The legacy fallbacks adopt and rename whatever they match, which is what we
    want for an old "Exit Game Mode" tile. Applying them to `--name Discord`
    would instead replace the exit tile with Discord, so they are limited to
    runs that are actually managing the exit entry.
    """
    return (any(marker in exe for marker in LEGACY_EXE_MARKERS)
            or name in LEGACY_NAMES)


def find_entry(shortcuts, exe, name):
    legacy = manages_exit_entry(exe, name)
    for index, entry in shortcuts.items():
        if not isinstance(entry, dict):
            continue
        app = entry.get("AppName") or ""
        stored = str(entry.get("Exe", ""))
        if app == name or exe in stored:
            return index
        if not legacy:
            continue
        if app in LEGACY_NAMES:
            return index
        if any(marker in stored for marker in LEGACY_EXE_MARKERS):
            return index
    return None


def next_index(shortcuts):
    used = [int(k) for k in shortcuts if k.isdigit()]
    return str(max(used) + 1 if used else 0)


# Directories that are not the user's to write into, so not somewhere to leave
# a program sitting while it runs.
SYSTEM_PREFIXES = ("/usr/", "/bin/", "/sbin/", "/opt/", "/nix/")


def start_dir(exe):
    """The working directory the tile should start in.

    Steam's own default for a shortcut is the program's own directory, which
    for anything in /usr/bin is a directory nobody can write to. Most programs
    do not care; one that drops a log or a crash file beside itself fails for a
    reason that has nothing to do with console mode. So a program living
    somewhere system-owned starts in the user's home instead.
    """
    where = os.path.dirname(exe)
    if not where or any(f"{where}/".startswith(prefix) for prefix in SYSTEM_PREFIXES):
        return os.path.expanduser("~")
    return where


def launch_options(exe, name, wrapper):
    """How Steam should run this tile.

    %command% is Steam's placeholder for the entry's own Exe and arguments, so
    putting the wrapper here runs the program through it without the library
    entry pointing anywhere else. That is the whole reason it goes in the
    launch options: the appid is derived from the Exe, and moving the Exe to
    the wrapper would renumber the tile and orphan its artwork and settings.
    """
    if wrapper is None or manages_exit_entry(exe, name):
        return ""
    return f'"{wrapper}" -- %command%'


def build_entry(exe, name, icon="", wrapper=None):
    quoted = f'"{exe}"'       # Steam stores Exe and StartDir quoted
    return {
        "appid": shortcut_appid(quoted, name),
        "AppName": name,
        "Exe": quoted,
        "StartDir": f'"{start_dir(exe)}/"',
        # Separate from the grid artwork: this is the small icon Steam shows
        # in list views and in the running-game banner.
        "icon": icon,
        "ShortcutPath": "",
        "LaunchOptions": launch_options(exe, name, wrapper),
        "IsHidden": 0,
        "AllowDesktopConfig": 1,
        "AllowOverlay": 1,
        "OpenVR": 0,
        "Devkit": 0,
        "DevkitGameID": "",
        "DevkitOverrideAppID": 0,
        "LastPlayTime": 0,
        "FlatpakAppID": "",
        "tags": {},
    }


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true",
                    help="show what would change, write nothing")
    ap.add_argument("--revert", action="store_true",
                    help="remove the shortcut instead of adding it")
    ap.add_argument("--force", action="store_true",
                    help="edit even while Steam is running (it will be lost)")
    ap.add_argument("--name", default=DEFAULT_NAME, help="library entry name")
    ap.add_argument("--exe", default=default_exe(),
                    help="program the entry runs")
    ap.add_argument("--icon", help="image to build the library artwork from "
                                   "(default: the program's installed icon)")
    ap.add_argument("--no-art", action="store_true",
                    help="add the entry but leave its tile blank")
    ap.add_argument("--no-wrap", action="store_true",
                    help="launch the program directly, without the helper that "
                         "frees its single-instance lock and quits it when its "
                         "window closes")
    args = ap.parse_args()

    if not args.dry_run and steam_running() and not args.force:
        print("Steam is running. It rewrites shortcuts.vdf on exit, which would\n"
              "discard this change. Close Steam first, or pass --force.",
              file=sys.stderr)
        return 1

    if not args.revert and not os.access(args.exe, os.X_OK):
        print(f"not executable: {args.exe}", file=sys.stderr)
        return 1

    paths = config_paths()
    if not paths:
        print(f"no Steam user config found under {STEAM_ROOT}/userdata",
              file=sys.stderr)
        return 1

    # Steam gives a shortcut a blank grey tile, which from a sofa tells you
    # nothing. The artwork is filed under the same appid as the entry, so it
    # is generated here rather than being left as a manual step.
    icon = args.icon or ""
    if artwork is not None and not args.no_art:
        print("artwork:")
        if args.revert:
            artwork.remove(args.exe, args.name, args.dry_run)
        else:
            icon = artwork.install(args.exe, args.name, args.icon,
                                   args.dry_run) or icon

    wrapper = None if args.no_wrap else sibling("cachy-console-app")
    options = launch_options(args.exe, args.name, wrapper)
    if options:
        print(f"launching through {wrapper}")

    for path in paths:
        account = os.path.basename(os.path.dirname(os.path.dirname(path)))
        print(f"account {account}:")
        try:
            obj = load(path)
        except VDFError as exc:
            print(f"  cannot parse existing shortcuts.vdf ({exc}); "
                  f"leaving it alone", file=sys.stderr)
            continue

        shortcuts = obj["shortcuts"]
        existing = find_entry(shortcuts, args.exe, args.name)

        if args.revert:
            if existing is None:
                print("  no matching entry; nothing to remove")
                continue
            del shortcuts[existing]
            # Steam expects consecutive numeric keys.
            obj["shortcuts"] = {str(n): v for n, v in enumerate(shortcuts.values())}
            print(f"  removing {args.name!r}")
        else:
            entry = build_entry(args.exe, args.name, icon, wrapper)
            if existing is not None:
                old_name = shortcuts[existing].get("AppName") or args.name
                if old_name in LEGACY_NAMES and old_name != args.name:
                    entry = build_entry(args.exe, old_name, icon, wrapper)
                shortcuts[existing] = entry
                print(f"  updating existing entry {existing} -> {entry['AppName']!r} ({args.exe})")
            else:
                index = next_index(shortcuts)
                shortcuts[index] = entry
                print(f"  adding entry {index}: {args.name!r} -> {args.exe}")
                other = len(shortcuts) - 1
                if other:
                    print(f"  ({other} existing shortcut(s) preserved)")

        save(path, obj, args.dry_run)

    return 0


if __name__ == "__main__":
    sys.exit(main())
