#!/usr/bin/env python3
"""Make the Steam button open console mode.

Pressing the Steam button twice does not launch anything: it flips the *already
running* Steam client into Big Picture, so there is no command to wrap. And
gamescope cannot adopt a window belonging to another compositor, so an
already-open Big Picture can never be moved into one.

Steam only does that flip in the window that has focus. A browser that is
clicked into swallows the presses, Big Picture never appears, and this used
to do nothing. The Steam button is also read from the controller itself, so
a double press starts console mode even when Steam is in the tray.

Relaunching Steam under gamescope is therefore the only way in. This watches for
Big Picture appearing on the desktop and does exactly that, by running
`cachy-console`. When the session ends it brings the ordinary desktop Steam
client back, so the Steam button works again next time.

Nothing about your display arrangement is ever changed; your other monitors keep
running the desktop throughout.

State machine:
  IDLE     -> STARTING  Big Picture appeared; `cachy-console` runs
  STARTING -> GAME      gamescope appeared
  STARTING -> IDLE      it did not appear within --start-timeout
  GAME     -> IDLE      gamescope exited; the desktop Steam client is restarted

A game launched straight from the desktop never triggers anything, because Big
Picture was never opened.

Steam can be configured to start *itself* in Big Picture, which would otherwise
ping-pong between desktop and console mode forever, so starts are rate limited.
"""

import argparse
import os
import re
import shutil
import signal
import struct
import subprocess
import sys
import time

# Turned off on purpose, as opposed to having stopped working. The service is set
# to come back from anything else, including a plain kill, so it needs a way to
# say "do not" that systemd can tell apart from exiting cleanly.
EXIT_DISABLED = 78

# WM_CLASS of Steam's own windows (desktop client and Big Picture alike).
STEAM_CLASSES = {"steam", "steamwebhelper"}
# WM_CLASS of a running game, e.g. steam_app_1623730.
GAME_CLASS_RE = re.compile(r"^steam_app_\d+$")

CLIENT_LIST_RE = re.compile(r"0x[0-9a-fA-F]+")

CONFIG_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "cachy-console", "config")


def read_config():
    """The user's settings, or an empty dict before they have run setup."""
    values = {}
    try:
        with open(CONFIG_PATH) as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip()
                if "=" not in line:
                    continue
                key, _, value = line.partition("=")
                values[key.strip()] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return values


def log(msg):
    print(f"[cachy-console-watch] {msg}", flush=True)


_sent = []


def notify(summary, body):
    """Say it on screen as well as in the journal.

    The cases this is for all look the same from the couch and none of them look
    like their cause: the saved screen being off leaves Big Picture sitting on the
    desktop, on whichever monitor the client felt like, which reads as console
    mode having opened on the wrong one. The journal has said so all along, which
    is no use to anyone holding a controller.

    Sent and forgotten, never waited on. A desktop can have no notification
    daemon at all -- measured here, the name is merely activatable and starting
    it times out after 25s -- and the Steam button has to keep working through
    that. Handles are kept only to reap them, so a wedged daemon cannot leave a
    zombie behind either.
    """
    if not shutil.which("notify-send"):
        return
    _sent[:] = [p for p in _sent if p.poll() is None]
    try:
        _sent.append(subprocess.Popen(
            ["notify-send", "--app-name=Console Mode", "--icon=input-gaming",
             # Replaces its own previous notification rather than stacking one
             # per poll. Understood by Plasma and GNOME; harmless elsewhere.
             "--hint=string:x-canonical-private-synchronous:cachy-console",
             summary, body],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
    except OSError:
        pass


def ensure_session_env():
    """Plasma often starts systemd --user without DISPLAY/WAYLAND_DISPLAY."""
    if not os.environ.get("DISPLAY"):
        try:
            socks = sorted(
                s for s in os.listdir("/tmp/.X11-unix")
                if s.startswith("X") and s[1:].isdigit())
        except OSError:
            socks = []
        if socks:
            os.environ["DISPLAY"] = f":{socks[0][1:]}"
    if not os.environ.get("XAUTHORITY"):
        runtime = os.environ.get("XDG_RUNTIME_DIR", "")
        candidates = []
        if runtime:
            candidates.append(os.path.join(runtime, "Xauthority"))
            try:
                candidates.extend(
                    os.path.join(runtime, n) for n in os.listdir(runtime)
                    if n.startswith("xauth"))
            except OSError:
                pass
        candidates.append(os.path.expanduser("~/.Xauthority"))
        for path in candidates:
            if os.path.isfile(path):
                os.environ["XAUTHORITY"] = path
                break
    if not os.environ.get("WAYLAND_DISPLAY"):
        runtime = os.environ.get("XDG_RUNTIME_DIR", "")
        sock = os.path.join(runtime, "wayland-0") if runtime else ""
        if sock and os.path.exists(sock):
            os.environ["WAYLAND_DISPLAY"] = "wayland-0"


class Xprop:
    """Thin wrapper around xprop; returns None when X is unreachable."""

    def __init__(self, binary="xprop"):
        self.binary = binary

    def _run(self, args):
        try:
            res = subprocess.run(
                [self.binary, *args],
                capture_output=True,
                text=True,
                timeout=5,
            )
        except (OSError, subprocess.TimeoutExpired):
            return None
        if res.returncode != 0:
            return None
        return res.stdout

    def active_window(self):
        out = self._run(["-root", "_NET_ACTIVE_WINDOW"])
        if not out:
            return None
        ids = CLIENT_LIST_RE.findall(out)
        if not ids or int(ids[0], 16) == 0:
            return None
        return ids[0]

    def client_list(self):
        out = self._run(["-root", "_NET_CLIENT_LIST"])
        if not out:
            return []
        return CLIENT_LIST_RE.findall(out)

    def window(self, wid):
        """Return {'id', 'classes', 'name'} for a window id."""
        out = self._run(["-id", wid, "WM_CLASS", "_NET_WM_NAME"])
        if not out:
            return None
        classes, name = set(), ""
        for line in out.splitlines():
            # Missing properties come back as 'WM_CLASS:  not found.', which
            # has no ' = ' and must not be parsed as a value.
            key, sep, value = line.partition(" = ")
            if not sep:
                continue
            if key.startswith("WM_CLASS"):
                classes = {v.strip().strip('"').lower()
                           for v in value.split(",") if v.strip()}
            elif key.startswith("_NET_WM_NAME"):
                name = value.strip().strip('"')
        return {"id": wid, "classes": classes, "name": name}


class XlibProps:
    """The same three questions as Xprop, asked over one X connection.

    Xprop starts a process per window per poll -- about eleven every half
    second on this desk, which is 32 minutes of CPU over a 2.4-hour login, and
    the reason the poll could not be made faster to notice the Steam button
    sooner. Reading the properties directly costs about a millisecond a poll.
    """

    _on_error = None

    def __init__(self):
        import ctypes
        import ctypes.util
        self._c = ctypes
        path = ctypes.util.find_library("X11") or "libX11.so.6"
        x = ctypes.CDLL(path)
        x.XOpenDisplay.restype = ctypes.c_void_p
        x.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x.XDefaultRootWindow.restype = ctypes.c_ulong
        x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        x.XInternAtom.restype = ctypes.c_ulong
        x.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
        x.XGetWindowProperty.argtypes = [
            ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_long,
            ctypes.c_long, ctypes.c_int, ctypes.c_ulong,
            ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int),
            ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
            ctypes.POINTER(ctypes.c_void_p)]
        x.XFree.argtypes = [ctypes.c_void_p]
        x.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        # A window can close between being listed and being asked about. Xlib's
        # default answer to that BadWindow is to end the process, so it is
        # swallowed here and the call reports failure instead. The handler is
        # process-wide and kept on the class: one that belonged to an instance
        # already collected is a segfault on the next error.
        if XlibProps._on_error is None:
            handler_type = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p,
                                            ctypes.c_void_p)
            XlibProps._on_error = handler_type(lambda _dpy, _event: 0)
            x.XSetErrorHandler.argtypes = [handler_type]
            x.XSetErrorHandler(XlibProps._on_error)
        self._x = x
        self._dpy = x.XOpenDisplay(None)
        if not self._dpy:
            raise OSError("cannot open the X display")
        self._root = x.XDefaultRootWindow(self._dpy)
        self._atoms = {name: x.XInternAtom(self._dpy, name.encode(), 0)
                       for name in ("_NET_CLIENT_LIST", "_NET_ACTIVE_WINDOW",
                                    "_NET_WM_NAME", "WM_CLASS")}

    def _get(self, window, atom):
        """(format, raw bytes, item count) of a property, or None."""
        c = self._c
        actual_type, actual_format = c.c_ulong(), c.c_int()
        nitems, after, data = c.c_ulong(), c.c_ulong(), c.c_void_p()
        status = self._x.XGetWindowProperty(
            self._dpy, window, self._atoms[atom], 0, 1 << 16, 0, 0,
            c.byref(actual_type), c.byref(actual_format), c.byref(nitems),
            c.byref(after), c.byref(data))
        # The error handler runs on the reply, which XGetWindowProperty has
        # already waited for; nothing further to sync.
        if status != 0 or not data.value:
            return None
        try:
            if actual_format.value == 32:
                # Format 32 comes back as C longs, whatever their width.
                ids = c.cast(data, c.POINTER(c.c_ulong))
                return [ids[i] for i in range(nitems.value)]
            return c.string_at(data, nitems.value)
        finally:
            self._x.XFree(data)

    def active_window(self):
        ids = self._get(self._root, "_NET_ACTIVE_WINDOW")
        if not ids or not isinstance(ids, list) or ids[0] == 0:
            return None
        return hex(ids[0])

    def client_list(self):
        ids = self._get(self._root, "_NET_CLIENT_LIST")
        return [hex(i) for i in ids] if isinstance(ids, list) else []

    def window(self, wid):
        """Return {'id', 'classes', 'name'} for a window id."""
        try:
            window = int(wid, 16)
        except ValueError:
            return None
        raw_class = self._get(window, "WM_CLASS")
        raw_name = self._get(window, "_NET_WM_NAME")
        if raw_class is None and raw_name is None:
            return None
        classes = set()
        if isinstance(raw_class, bytes):
            classes = {part.decode("utf-8", "replace").strip().lower()
                       for part in raw_class.split(b"\0") if part.strip()}
        name = raw_name.decode("utf-8", "replace") if isinstance(raw_name, bytes) else ""
        return {"id": wid, "classes": classes, "name": name}


def window_source():
    """XlibProps where libX11 can be loaded and the display opened, else Xprop."""
    try:
        return XlibProps()
    except (OSError, AttributeError):
        return Xprop()


# gamescope's own process name is gamescope-wl, which is why a plain
# `pgrep -x gamescope` reports nothing while a session is clearly running.
GAMESCOPE_COMMS = frozenset(("gamescope", "gamescope-wl"))


def proc_state(pid):
    """Single-letter state from /proc/PID/status, or None if it is gone."""
    try:
        with open(f"/proc/{pid}/status") as fh:
            for line in fh:
                if line.startswith("State:"):
                    rest = line.split(None, 1)
                    return rest[1].strip()[:1] if len(rest) > 1 else None
    except OSError:
        pass
    return None


def gamescope_pids():
    """PIDs of the gamescope compositors currently running.

    Zombies are excluded on purpose. `cachy-console` execs into gamescope, so
    the process left behind is our own child; until we reap it, an exited
    gamescope keeps a /proc entry that still reports its name, and counting it
    would pin us in GAME forever and never restore the desktop client.
    """
    pids = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return pids
    for entry in entries:
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/comm") as fh:
                comm = fh.read().strip()
        except OSError:
            continue          # process exited while we were looking at it
        if comm not in GAMESCOPE_COMMS:
            continue
        if proc_state(entry) == "Z":
            continue
        pids.append(int(entry))
    return pids


class Session:
    """Starts and tracks the console-mode gamescope session."""

    def __init__(self, console, helper, display, dry_run=False,
                 relaunch_steam=True, log_path=None, display_locked=False):
        self.console = console
        self.helper = helper
        self.display = display or ""
        self.display_locked = display_locked
        self.dry_run = dry_run
        self.relaunch_steam = relaunch_steam
        self.log_path = log_path or os.path.join(
            os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "cachy-console-session.log")
        self._proc = None

    def connected(self):
        """Whether the saved display is actually plugged in and on.

        An empty or "auto" target is treated as disconnected: we must not look
        for some other screen to use instead.
        """
        if not self.display or self.display.lower() == "auto" or self.display.isdigit():
            return False
        try:
            res = subprocess.run(
                [self.helper, "has", self.display],
                capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            return False
        return res.returncode == 0

    def running(self):
        # Live nested compositor is gamescope-wl. Polling reaps a zombie so a
        # dead session cannot pin us in GAME forever.
        if self._proc is not None and self._proc.poll() is not None:
            self._proc = None
        return bool(gamescope_pids())

    def start(self):
        """Run `cachy-console`, which restarts Steam inside gamescope."""
        # Read the saved connector now, not the one from when this process
        # started. Otherwise a Cachy Console save after the last session is
        # ignored until the *following* launch.
        if not self.display_locked:
            self.refresh_target()
        if self.dry_run:
            log(f"[dry-run] would start console mode on {self.display}")
            return True
        if not self.display:
            log("no display saved; not starting.")
            return False
        try:
            out = open(self.log_path, "w")
        except OSError as exc:
            log(f"cannot write {self.log_path}: {exc}")
            return False
        try:
            # Do not pass --display: cachy-console reads the config file at
            # exec, so the connector saved a moment ago is the one that runs.
            argv = [self.console]
            if self.display_locked:
                argv.extend(["--display", self.display])
            self._proc = subprocess.Popen(
                argv,
                stdin=subprocess.DEVNULL,
                stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        except OSError as exc:
            log(f"could not run {self.console}: {exc}")
            return False
        finally:
            out.close()
        log(f"session output goes to {self.log_path}")
        return True

    def restore_audio(self):
        """Put HDMI audio back if console mode left the GPU profile switched.

        The wrapper restores on EXIT, but a crash can skip that trap.
        Restoring twice is a no-op once the state file is gone.
        """
        if self.dry_run:
            log("[dry-run] would restore HDMI audio")
            return
        try:
            subprocess.run(
                [self.helper, "audio-restore"],
                capture_output=True, text=True, timeout=8)
        except (OSError, subprocess.TimeoutExpired):
            pass

    def refresh_target(self):
        """Re-read the saved connector. A settings change should take effect
        without restarting this service, and a display coming back should still
        be the same saved one — never a newly appeared monitor.
        """
        if self.display_locked:
            return self.display
        raw = (read_config().get("DISPLAY") or "").strip()
        if not raw or raw.lower() == "auto" or raw.isdigit():
            self.display = ""
        else:
            self.display = raw
        return self.display

    def relaunch_desktop_steam(self):
        """Bring back the desktop client, so the Steam button works again.

        Handed to `cachy-console restart-steam` rather than done here. The
        wrapper knows what console mode exported into Steam's environment and so
        what has to be stripped back out, it honours RESTART_STEAM, and it does
        the same thing from its own exit path when it outlives the session. Both
        of us call it because neither is always the survivor: the wrapper's
        process group goes down with gamescope's reaper when the exit tile is
        clicked from inside the session, and this service is not running at all
        when STEAM_BUTTON is off. A lock in there settles who actually starts it.
        """
        if not self.relaunch_steam:
            return
        if self.dry_run:
            log("[dry-run] would relaunch the desktop Steam client")
            return
        try:
            subprocess.Popen(
                [self.console, "restart-steam"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
        except OSError as exc:
            log(f"could not run {self.console}: {exc}")


def _sibling_or_path(name):
    """Prefer the copy next to this script, then fall back to PATH."""
    here = os.path.dirname(os.path.abspath(__file__))
    local = os.path.join(here, name)
    if os.access(local, os.X_OK):
        return local
    found = shutil.which(name)
    if found:
        return found
    sys.exit(f"cachy-console-watch: cannot find {name}")


def find_helper():
    return _sibling_or_path("cachy-console-display")


def find_console():
    return _sibling_or_path("cachy-console")


def pending_shortcuts_path():
    root = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(root, "cachy-console", "pending-shortcuts.json")


def maybe_flush_shortcuts(run=subprocess.run):
    """Write queued library tiles once Steam is no longer holding the file."""
    if not os.path.isfile(pending_shortcuts_path()):
        return
    try:
        helper = _sibling_or_path("cachy-console-shortcut")
    except SystemExit:
        return
    try:
        run([helper, "--flush"], timeout=30,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass


def classify(win, bpm_re):
    if win is None:
        return "none"
    if any(GAME_CLASS_RE.match(c) for c in win["classes"]):
        return "game"
    if win["classes"] & STEAM_CLASSES:
        return "bigpicture" if bpm_re.search(win["name"]) else "steam"
    return "other"


# Steam's own virtual pad (28de:11ff) and the dongle (28de:1102/1142/1304).
VALVE_VENDOR = "28de"
# linux/input-event-codes.h
EV_KEY = 1
BTN_MODE = 0x13C
EVENT_FORMAT = "llHHI"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
# hid-steam: Steam logo is byte 9 bit 5 on the Deck/puck report, byte 4 bit 0
# on the 2015 controller report.
HID_STEAM_BITS = ((9, 5), (4, 0))


class DoublePress:
    """Two edges inside `window` seconds, ignoring the same press seen twice."""

    def __init__(self, window=0.55, debounce=0.04):
        self.window = window
        self.debounce = debounce
        self.times = []

    def feed(self, now):
        if self.times and now - self.times[-1] < self.debounce:
            return False
        self.times = [t for t in self.times if now - t <= self.window]
        self.times.append(now)
        if len(self.times) >= 2:
            self.times.clear()
            return True
        return False


class GuideButtons:
    """The Steam button on a Valve pad, whether or not Steam has focus.

    Steam's client only opens Big Picture when its own window is focused, so
    a double press over Firefox used to do nothing. The virtual pad and the
    dongle still see the button; this watches those and does not grab them.
    """

    def __init__(self, evdev_root="/dev/input", hidraw_root="/dev",
                 sys_input="/sys/class/input", sys_hidraw="/sys/class/hidraw"):
        self.evdev_root = evdev_root
        self.hidraw_root = hidraw_root
        self.sys_input = sys_input
        self.sys_hidraw = sys_hidraw
        self._fds = {}
        self._hid_down = {}
        self._presses = DoublePress()
        self._next_scan = 0.0
        self._said = False
        self._scan()

    def close(self):
        for fd in self._fds.values():
            try:
                os.close(fd)
            except OSError:
                pass
        self._fds.clear()

    def _vendor(self, sysdir, name):
        try:
            with open(os.path.join(sysdir, name, "device", "id", "vendor")) as fh:
                return fh.read().strip().lower()
        except OSError:
            try:
                with open(os.path.join(sysdir, name, "device", "uevent")) as fh:
                    for line in fh:
                        if line.startswith("HID_ID="):
                            parts = line.split("=")[1].strip().split(":")
                            return parts[1].lstrip("0").lower() or "0"
            except OSError:
                return ""
        return ""

    def _scan(self):
        wanted = {}
        try:
            nodes = os.listdir(self.sys_input)
        except OSError:
            nodes = []
        for name in nodes:
            if not name.startswith("event"):
                continue
            if self._vendor(self.sys_input, name) != VALVE_VENDOR:
                continue
            path = os.path.join(self.evdev_root, name)
            wanted[path] = "evdev"
        try:
            nodes = os.listdir(self.sys_hidraw)
        except OSError:
            nodes = []
        for name in nodes:
            if not name.startswith("hidraw"):
                continue
            if self._vendor(self.sys_hidraw, name) != VALVE_VENDOR:
                continue
            path = os.path.join(self.hidraw_root, name)
            wanted[path] = "hidraw"
        for path in list(self._fds):
            if path not in wanted:
                try:
                    os.close(self._fds.pop(path))
                except OSError:
                    self._fds.pop(path, None)
                self._hid_down.pop(path, None)
        for path, kind in wanted.items():
            if path in self._fds:
                continue
            try:
                self._fds[path] = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            if kind == "hidraw":
                self._hid_down[path] = False
        if not self._said:
            self._said = True
            if self._fds:
                log("listening for the Steam button on "
                    + ", ".join(os.path.basename(p) for p in sorted(self._fds)))
            else:
                log("could not read a Valve controller; the Steam button still "
                    "needs Steam focused")

    def _evdev_pressed(self, fd):
        hit = False
        while True:
            try:
                raw = os.read(fd, EVENT_SIZE * 8)
            except BlockingIOError:
                break
            except OSError:
                return None
            if not raw:
                break
            for off in range(0, len(raw) - EVENT_SIZE + 1, EVENT_SIZE):
                _sec, _usec, typ, code, value = struct.unpack_from(
                    EVENT_FORMAT, raw, off)
                if typ == EV_KEY and code == BTN_MODE and value == 1:
                    hit = True
        return hit

    def _hid_pressed(self, fd, path):
        hit = False
        while True:
            try:
                raw = os.read(fd, 64)
            except BlockingIOError:
                break
            except OSError:
                return None
            if not raw:
                break
            down = any(len(raw) > byte and (raw[byte] & (1 << bit))
                       for byte, bit in HID_STEAM_BITS)
            if down and not self._hid_down.get(path):
                hit = True
            self._hid_down[path] = down
        return hit

    def double_pressed(self, now):
        if now >= self._next_scan:
            self._scan()
            self._next_scan = now + 2.0
        dead = []
        hit = False
        for path, fd in self._fds.items():
            if path.startswith(self.hidraw_root) and "hidraw" in os.path.basename(path):
                got = self._hid_pressed(fd, path)
            else:
                got = self._evdev_pressed(fd)
            if got is None:
                dead.append(path)
            elif got:
                hit = True
        for path in dead:
            try:
                os.close(self._fds.pop(path))
            except OSError:
                self._fds.pop(path, None)
            self._hid_down.pop(path, None)
            self._next_scan = now
        return self._presses.feed(now) if hit else False


class NullGuide:
    def double_pressed(self, now):
        return False

    def close(self):
        pass


def present_kinds(xprop, bpm_re):
    """What kinds of window currently exist.

    Deliberately based on which windows are mapped rather than which one is
    focused: with Big Picture fullscreen, compositors have been seen reporting
    _NET_ACTIVE_WINDOW as an unrelated internal window, so keying off focus
    never fires. Big Picture's window only exists while it is open, so its
    presence is the reliable signal.
    """
    kinds = set()
    for wid in xprop.client_list():
        win = xprop.window(wid)
        if win is not None:
            kinds.add(classify(win, bpm_re))
    return kinds


def discover(xprop, bpm_re, interval):
    log("discover mode: no display changes will be made.")
    log("Press the Steam button / open Big Picture and watch the output.")
    log("The line marked >>> is the currently focused window.")
    previous = None
    while True:
        active = xprop.active_window()
        rows = []
        for wid in xprop.client_list():
            win = xprop.window(wid)
            if win is None:
                continue
            rows.append((
                ">>>" if wid == active else "   ",
                wid,
                ",".join(sorted(win["classes"])),
                win["name"],
                classify(win, bpm_re),
            ))
        snapshot = repr(rows)
        if snapshot != previous:
            previous = snapshot
            print()
            log(f"--- window list changed ({time.strftime('%H:%M:%S')}) ---")
            for mark, wid, cls, name, kind in rows:
                print(f"  {mark} {wid:>11}  {kind:<11} "
                      f"class={cls:<28} name={name!r}")
        time.sleep(interval)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--display", default=None,
                    help="which display to open console mode on; defaults to "
                         "the DISPLAY setting in the config file")
    ap.add_argument("--interval", type=float, default=0.2,
                    help="seconds between polls (default 0.2)")
    ap.add_argument("--engage-polls", type=int, default=2,
                    help="polls before acting, so ~0.4s (default 2)")
    ap.add_argument("--start-timeout", type=float, default=90.0,
                    help="seconds to wait for gamescope to appear (default 90)")
    ap.add_argument("--max-starts", type=int, default=3,
                    help="sessions allowed per --start-window before giving up "
                         "(default 3)")
    ap.add_argument("--start-window", type=float, default=300.0,
                    help="window for --max-starts, in seconds (default 300)")
    ap.add_argument("--no-steam-relaunch", dest="relaunch_steam",
                    action="store_false",
                    help="do not restart the desktop Steam client afterwards")
    ap.add_argument("--bpm-pattern", default=os.environ.get(
        "CACHY_CONSOLE_BPM_PATTERN", "big.?picture"),
        help="case-insensitive regex matched against the window title")
    ap.add_argument("--dry-run", action="store_true",
                    help="log decisions without starting or stopping anything")
    ap.add_argument("--discover", action="store_true",
                    help="print Steam windows as they change and exit on Ctrl-C")
    ap.add_argument("--once", action="store_true",
                    help="report the current classification and exit")
    args = ap.parse_args()

    # Output is usually a pipe or the journal, where the default block
    # buffering would swallow everything if we get killed.
    sys.stdout.reconfigure(line_buffering=True)

    config = read_config()
    # Opting out should stop the service doing anything, not merely be
    # something the user has to remember to disable in systemd as well.
    if config.get("STEAM_BUTTON", "on").lower() in ("off", "no", "0", "false"):
        log("STEAM_BUTTON is off in the config; nothing to do.")
        return EXIT_DISABLED
    display = args.display
    display_locked = bool(args.display)
    if not display_locked:
        raw = (config.get("DISPLAY") or "").strip()
        display = "" if (not raw or raw.lower() == "auto" or raw.isdigit()) else raw

    bpm_re = re.compile(args.bpm_pattern, re.I)
    ensure_session_env()
    xprop = window_source()

    if xprop.active_window() is None and not xprop.client_list():
        log("cannot read X11 windows. Is DISPLAY/XAUTHORITY set? "
            "(a systemd --user service inherits them from the session)")
        return 1

    if args.discover:
        try:
            discover(xprop, bpm_re, max(args.interval, 0.5))
        except KeyboardInterrupt:
            print()
            log("done.")
        return 0

    session = Session(find_console(), find_helper(), display,
                      args.dry_run, args.relaunch_steam,
                      display_locked=display_locked)

    if args.once:
        for wid in xprop.client_list():
            win = xprop.window(wid)
            if win is not None:
                log(f"  {wid} {classify(win, bpm_re):<11} "
                    f"class={','.join(sorted(win['classes']))} "
                    f"name={win['name']!r}")
        kinds = present_kinds(xprop, bpm_re)
        log(f"kinds present:  {sorted(kinds) or ['none']}")
        log(f"would start:    {'bigpicture' in kinds}")
        log(f"display {display}: {'connected' if session.connected() else 'not connected'}")
        pids = gamescope_pids()
        log(f"gamescope:      {pids or 'not running'}")
        return 0

    stopping = {"now": False}

    def on_signal(signum, _frame):
        stopping["now"] = True

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGHUP, on_signal)

    if display:
        log(f"watching for Big Picture; will open console mode on {display}"
            + (" (dry run)" if args.dry_run else ""))
    else:
        log("watching for Big Picture; no display saved yet "
            "(open Console Mode Settings)"
            + (" (dry run)" if args.dry_run else ""))

    guide = GuideButtons()
    try:
        run_loop(xprop, session, bpm_re, args, stopping, time.sleep, guide=guide,
                 flush_shortcuts=maybe_flush_shortcuts)
    finally:
        guide.close()
    log("stopped.")
    return 0


IDLE, STARTING, GAME = "idle", "starting", "game"


def run_loop(xprop, session, bpm_re, args, stopping, sleep,
             now=time.monotonic, announce=notify, guide=None,
             flush_shortcuts=None):
    """The state machine, kept separate so it can be driven by fakes in tests."""
    state = IDLE
    engage_streak = 0
    deadline = 0.0
    starts = []
    # A stand-down repeats for as long as Big Picture stays up, which would fill
    # the journal with one identical line per poll. Log a reason only when it
    # changes, and forget it once the situation does.
    last_standdown = None
    # After we leave a session, Steam often restores itself into Big Picture.
    # Treating that leftover window as a new Steam-button press relaunches
    # gamescope on the previous display before the user can save a new one in
    # Cachy Console. Wait until Big Picture has actually gone away, then treat
    # the next appearance as a real request.
    awaiting_bpm_clear = False
    # When the /proc scan for a gamescope started by hand is next due. Ours is
    # followed from STARTING, so the scan only finds sessions nothing is waiting
    # on, and at five polls a second it was the watcher's largest cost.
    next_scan = 0.0
    guide = guide or NullGuide()

    def stand_down(reason, message, headline=None):
        nonlocal last_standdown
        if reason != last_standdown:
            log(message)
            # Once per stand-down, for the same reason the log line is: the state
            # is invisible otherwise, and every one of these is something the
            # person at the controller can act on.
            if headline:
                announce(headline, message)
            last_standdown = reason

    while not stopping["now"]:
        if state == GAME:
            if not session.running():
                log("console mode ended -> bringing the desktop Steam client back.")
                if hasattr(session, "restore_audio"):
                    session.restore_audio()
                session.relaunch_desktop_steam()
                state = IDLE
                engage_streak = 0
                last_standdown = None
                awaiting_bpm_clear = True
                # Watched rather than slept through. The guard itself is right --
                # a client that restores itself into Big Picture must not read as a
                # fresh request -- but it used to be paired with sleeping for the
                # whole settle period, and the state it cares about is a window
                # appearing and disappearing inside exactly that window. Leaving
                # console mode takes Big Picture with it, so the very next poll
                # clears the guard and a press half a minute later is honoured;
                # blind, the press was still on screen when the sleep ended and was
                # read as the last session's, which stood the watcher down until
                # someone thought to close Big Picture by hand.
                continue

        elif state == STARTING:
            if session.running():
                log(f"console mode is up on {session.display}.")
                state = GAME
            elif now() >= deadline:
                log(f"gamescope did not appear within {args.start_timeout:.0f}s; "
                    f"see {session.log_path}")
                state = IDLE
                engage_streak = 0

        else:
            scan = now() >= next_scan
            if scan:
                next_scan = now() + 1.0
                if flush_shortcuts:
                    flush_shortcuts()
            if scan and session.running():
                # Started by hand from a terminal, or left over from a restart.
                log("tracking a gamescope session we did not start.")
                state = GAME
            else:
                kinds = present_kinds(xprop, bpm_re)
                guide_hit = guide.double_pressed(now())
                if awaiting_bpm_clear:
                    if "bigpicture" in kinds:
                        stand_down("awaiting-clear",
                                   "Big Picture is still open from the last "
                                   "session; close it and press the Steam button "
                                   "twice to start console mode again.",
                                   headline="Close Big Picture to start again")
                        sleep(args.interval)
                        continue
                    awaiting_bpm_clear = False
                    last_standdown = None

                if "bigpicture" in kinds:
                    engage_streak += 1
                else:
                    engage_streak = 0
                    # Big Picture went away, so the next attempt is allowed to
                    # explain itself again.
                    last_standdown = None

                guide_ready = guide_hit and "game" not in kinds
                if engage_streak >= args.engage_polls or guide_ready:
                    engage_streak = 0

                    if hasattr(session, "refresh_target"):
                        session.refresh_target()

                    if not getattr(session, "display", None):
                        stand_down("unconfigured",
                                   "no display saved; open Console Mode Settings. "
                                   "Not using another screen.",
                                   headline="Console mode has no screen saved")
                        sleep(args.interval * 5)
                        continue

                    # With the saved display switched off, do not pick another.
                    # This keeps polling, so turning the screen on while Big
                    # Picture is still up starts console mode with no second
                    # press -- which is worth saying, because the alternative
                    # reading of the same screen is that it went to the wrong one.
                    if not session.connected():
                        stand_down(
                            "disconnected",
                            f"{session.display} is off or unplugged, so Big "
                            f"Picture is staying on the desktop rather than "
                            f"opening on another screen. Turn it on and console "
                            f"mode moves there on its own.",
                            headline=f"Console mode is waiting for {session.display}")
                        sleep(args.interval * 5)
                        continue

                    starts[:] = [t for t in starts if now() - t < args.start_window]
                    if len(starts) >= args.max_starts:
                        stand_down("throttled",
                                   f"{len(starts)} sessions started in the last "
                                   f"{args.start_window:.0f}s; refusing to loop. "
                                   f"Turn off Steam's 'start in Big Picture' "
                                   f"setting, then restart this service.",
                                   headline="Console mode stopped restarting")
                        sleep(args.interval * 10)
                        continue

                    last_standdown = None
                    why = ("Steam button twice" if guide_ready
                           and "bigpicture" not in kinds
                           else "Big Picture opened")
                    log(f"{why} -> switching to console mode"
                        f" on {session.display}.")
                    starts.append(now())
                    if session.start():
                        state = STARTING
                        deadline = now() + args.start_timeout
                    else:
                        stand_down("startfail",
                                   "could not start the session; will retry. See "
                                   f"{session.log_path} for what it said.",
                                   headline="Console mode could not start")

        # The fast poll is for noticing the Steam button. In a session nothing is
        # waiting on this loop but the return to the desktop, and half a second
        # there is not worth a /proc scan five times a second for hours.
        sleep(args.interval if state == IDLE else max(args.interval, 0.5))


if __name__ == "__main__":
    sys.exit(main())
