#!/usr/bin/env python3
"""Find the displays, what they are running at, and how gamescope numbers them.

Everything here is deliberately compositor-agnostic. CachyOS ships KDE by
default but is happy on GNOME, Hyprland or anything else, so asking a specific
compositor -- GNOME's Mutter over DBus, say -- would work for one desktop and
fail for the rest. SDL is asked instead, which is also what gamescope itself
uses, so the numbers here are the numbers it will act on.

SDL has to be asked twice, because neither backend alone tells the whole truth:

  x11      names displays by connector ("HDMI-1") and enumerates them in the
           order gamescope's --display-index expects, but under XWayland the
           refresh rate is whatever the X server made up, which can be 60 for a
           240Hz screen.
  wayland  reports the true mode straight from wl_output, but names displays by
           manufacturer ("Optoma Corporation"), which is no good for matching.

Each backend reports the same desktop-space position for a display, so the two
views are correlated on position: connector names and indices come from x11, and
resolution and refresh come from wayland. On a plain X11 session there is no
second view and x11 is used for everything, which is correct there anyway.

Subcommands:
  list [--json]         every display, its mode, and its gamescope index
  resolve [NAME]        the one to use: "INDEX WIDTH HEIGHT REFRESH CONNECTOR"
                        NAME is a connector. Omitted means the saved config.
                        Never substitutes another screen if the saved one is off.
  has [NAME]            exit 0 if that display (or the saved one) is connected
  saved                 print the saved connector, even if it is currently off
  set CONNECTOR         save CONNECTOR as the only display console mode will use
  probe [--driver X]    raw SDL output, for when something looks wrong
  audio-list            audio outputs and which one is saved for console mode
  audio-set NAME        save the audio output console mode will use
  audio-route           switch to the saved audio output (Steam's list)
  audio-resolve         the sink name to play through, switching nothing
  audio-restore         put the previous HDMI profile back after console mode
  audio-input-list      microphones and which one is saved
  audio-input-set NAME  save the microphone console mode will use
  audio-input-resolve   the PipeWire source name, for PULSE_SOURCE
  controllers           gamepads, their USB ids, and which console mode hides
"""

import argparse
import ctypes
import glob
import json
import os
import re
import subprocess
import sys
import time

SDL_INIT_VIDEO = 0x20
SDL_LIBS = ("libSDL2-2.0.so.0", "libSDL2.so", "libSDL2-2.0.so")

CONFIG_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "cachy-console", "config")


class DisplayError(Exception):
    pass


def run(args, timeout=8):
    try:
        res = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return None
    if res.returncode != 0:
        return None
    return res.stdout.decode("utf-8", "replace")


# ---- SDL ----------------------------------------------------------------

class _Mode(ctypes.Structure):
    _fields_ = [("format", ctypes.c_uint32), ("w", ctypes.c_int),
                ("h", ctypes.c_int), ("refresh_rate", ctypes.c_int),
                ("driverdata", ctypes.c_void_p)]


class _Rect(ctypes.Structure):
    _fields_ = [("x", ctypes.c_int), ("y", ctypes.c_int),
                ("w", ctypes.c_int), ("h", ctypes.c_int)]


_lib = None


def sdl():
    global _lib
    if _lib is None:
        for name in SDL_LIBS:
            try:
                _lib = ctypes.CDLL(name)
                break
            except OSError:
                continue
        else:
            raise DisplayError(
                "cannot load SDL2 — install it with: sudo pacman -S sdl2")
        _lib.SDL_GetDisplayName.restype = ctypes.c_char_p
        _lib.SDL_GetError.restype = ctypes.c_char_p
    return _lib


def enumerate_sdl(driver):
    """[{index, name, x, y, w, h, refresh}] as one SDL backend sees things."""
    lib = sdl()
    previous = os.environ.get("SDL_VIDEODRIVER")
    os.environ["SDL_VIDEODRIVER"] = driver
    try:
        if lib.SDL_Init(SDL_INIT_VIDEO) != 0:
            return []                      # backend unavailable in this session
        try:
            out = []
            for i in range(lib.SDL_GetNumVideoDisplays()):
                name = lib.SDL_GetDisplayName(i) or b""
                mode, rect = _Mode(), _Rect()
                lib.SDL_GetCurrentDisplayMode(i, ctypes.byref(mode))
                lib.SDL_GetDisplayBounds(i, ctypes.byref(rect))
                out.append({
                    "index": i,
                    "name": name.decode("utf-8", "replace"),
                    "x": rect.x, "y": rect.y,
                    "w": mode.w or rect.w, "h": mode.h or rect.h,
                    "refresh": mode.refresh_rate,
                })
            return out
        finally:
            lib.SDL_Quit()
    finally:
        if previous is None:
            os.environ.pop("SDL_VIDEODRIVER", None)
        else:
            os.environ["SDL_VIDEODRIVER"] = previous


def paired(x11, wayland):
    """The two backend views lined up, each screen against itself.

    Position is not a key the two views share. XWayland lays every screen out in
    logical pixels multiplied by the largest scale any screen uses, so one screen
    at 1.25 renames every position on the desktop: a 5120x1440 monitor at +1920
    is reported as 6400x1800 at +2400, and XWayland calls its 240Hz 12Hz while it
    is at it. Matching positions for equality there merges nothing, which is how a
    projector came to be listed with a mode and a name belonging to no screen.

    What that multiplication cannot do is reorder the screens, so rank by position
    is a key where equality is not. It is only trusted when the two views agree on
    the count, on which screens sit against an axis, on a single multiplier
    between their positions, and on the mode fitting inside the box x11 draws
    around it. Any of those failing means one view is stale, and a stale mode is
    one console mode would hand to gamescope.
    """
    if len(x11) != len(wayland):
        return []
    if stacked_displays(x11) or stacked_displays(wayland):
        return []
    pairs = list(zip(sorted(x11, key=lambda e: (e["y"], e["x"])),
                     sorted(wayland, key=lambda e: (e["y"], e["x"]))))
    multipliers = set()
    for mine, theirs in pairs:
        for axis in ("x", "y"):
            if bool(mine[axis]) != bool(theirs[axis]):
                return []
            if theirs[axis]:
                multipliers.add(round(mine[axis] / theirs[axis], 3))
        # x11 scales a screen's logical size back up by the largest scale in use,
        # so its box is never smaller than the mode. Smaller means these are not
        # the same screen.
        if mine["w"] < theirs["w"] or mine["h"] < theirs["h"]:
            return []
    if len(multipliers) > 1:
        return []
    return pairs


def displays():
    """Every display, merging what each SDL backend knows best.

    x11 is the authority on names and indices because that is the backend
    gamescope runs; wayland is the authority on everything about the screen
    itself, because XWayland's numbers are scaled and its refresh rates wrong.
    """
    x11 = enumerate_sdl("x11")
    if not x11:
        # No XWayland, so gamescope's SDL backend could not target an output
        # either. Report what we can and let the caller complain.
        wayland = enumerate_sdl("wayland")
        if not wayland:
            raise DisplayError(
                "SDL found no displays under either the x11 or wayland backend")
        return wayland

    wayland = enumerate_sdl("wayland")
    pairs = paired(x11, wayland)
    for display in x11:
        display.setdefault("model", "")
        # Disputed: wayland described the screens and the two views could not be
        # lined up, so what is left here is XWayland's own account of the mode --
        # scaled, and 12Hz for a screen running at 240. Nothing is in dispute when
        # wayland had nothing to say, as in a session that is not wayland at all.
        display["disputed"] = bool(wayland) and not pairs
    for mine, theirs in pairs:
        # The manufacturer string is far friendlier than a connector for
        # choosing a display, so keep it for matching and for display.
        mine["model"] = theirs["name"]
        mine["x"], mine["y"] = theirs["x"], theirs["y"]
        mine["w"], mine["h"] = theirs["w"], theirs["h"]
        mine["refresh"] = theirs["refresh"]
        mine["disputed"] = False
    return x11


def stacked_displays(entries):
    """The displays sharing a position with another one.

    An index only means a screen while the arrangement holds, and gamescope's
    nested backend can be pointed at a screen no other way: --prefer-output is
    read by the DRM backend alone, and SDL, handed an index that no longer
    exists, quietly puts the window on the first display instead. So a layout
    caught mid-change is not something to resolve an index against -- it is
    something to wait out. Two screens at one position is what that looks like.
    """
    counts = {}
    for entry in entries:
        key = (entry["x"], entry["y"])
        counts[key] = counts.get(key, 0) + 1
    return [e for e in entries if counts[(e["x"], e["y"])] > 1]


def connector_of(display):
    """The connector part of an SDL name: 'HDMI-1 55"' -> 'HDMI-1'."""
    return display["name"].split(" ")[0] if display["name"] else f"display-{display['index']}"


def normalize_connector(name):
    """The same physical port under Mutter and KWin names.

    Mutter/XRandR tends to say HDMI-1; KWin/DRM tends to say HDMI-A-1.
    DisplayPort is DP-1 in both, or DisplayPort-1 from some SDL builds.
    The letter after HDMI/DP/DVI is the connector *type*, not a second screen,
    so HDMI-A-1 and HDMI-1 are the same port. HDMI-1 and HDMI-2 are not.
    """
    token = (name or "").strip().split(" ")[0]
    if not token:
        return ""
    token = re.sub(r"displayport", "DP", token, flags=re.I)
    match = re.match(r"^(HDMI|DP|DVI|VGA|eDP|USB-C|USBC)-(?:[A-Z]-)?(\d+)$",
                     token, re.I)
    if not match:
        return token.lower()
    return f"{match.group(1).upper()}-{match.group(2)}"


def connectors_match(left, right):
    a, b = normalize_connector(left), normalize_connector(right)
    return bool(a and a == b)


# ---- selection ----------------------------------------------------------

def read_config():
    values = {}
    try:
        with open(CONFIG_PATH) as fh:
            for line in fh:
                # Trailing comments too, matching how the shell script and the
                # watcher read this same file.
                line = line.split("#", 1)[0].strip()
                if "=" not in line:
                    continue
                key, _, value = line.partition("=")
                values[key.strip()] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return values


def saved_connector():
    """The connector the user saved, or None if they have not chosen one.

    "auto" and a bare SDL index are treated as unset: an index is only valid
    while that exact set of displays is plugged in, so using it after a screen
    is turned off would silently send Big Picture to a different monitor.
    """
    raw = (read_config().get("DISPLAY") or "").strip()
    if not raw or raw.lower() == "auto" or raw.isdigit():
        return None
    return raw


def update_config(updates):
    """Change keys in the config file without rewriting the rest of it."""
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    try:
        with open(CONFIG_PATH) as fh:
            lines = fh.readlines()
    except OSError:
        lines = []
    seen = set()
    out = []
    for line in lines:
        stripped = line.split("#", 1)[0]
        if "=" not in stripped:
            out.append(line)
            continue
        key = stripped.split("=", 1)[0].strip()
        if key in updates:
            out.append(f"{key}={updates[key]}\n")
            seen.add(key)
            continue
        out.append(line)
    for key, value in updates.items():
        if key not in seen:
            out.append(f"{key}={value}\n")
    with open(CONFIG_PATH, "w") as fh:
        fh.writelines(out)


def pick(wanted=None, allow_index=False):
    """The display to run on, as one of the dicts from displays().

    The saved target is a connector (HDMI-1), not "whichever screen is on".
    If that connector is missing, this raises rather than picking another
    output: turning the TV off must not dump Big Picture onto a desktop monitor.
    """
    found = displays()
    if not found:
        raise DisplayError("no displays found")

    from_config = wanted is None
    if from_config:
        wanted = saved_connector()
        if not wanted:
            raise DisplayError(
                "no display saved — open Console Mode Settings and pick one")
        allow_index = False

    wanted = str(wanted).strip()
    if not wanted or wanted.lower() == "auto":
        raise DisplayError(
            "no display saved — open Console Mode Settings and pick one")

    if allow_index and wanted.isdigit():
        for display in found:
            if display["index"] == int(wanted):
                return display
        raise DisplayError(
            f"no display with index {wanted} (found {len(found)})")

    for display in found:
        if connectors_match(connector_of(display), wanted):
            return display

    known = ", ".join(connector_of(d) for d in found) or "none"
    raise DisplayError(
        f"saved display {wanted} is off or unplugged; not using another screen "
        f"(connected: {known})")


# ---- commands -----------------------------------------------------------

def cmd_list(args):
    found = displays()
    if args.json:
        print(json.dumps([dict(d, connector=connector_of(d)) for d in found],
                         indent=2))
        return 0
    configured = saved_connector() or ""
    print(f"  {'#':<3} {'connector':<12} {'mode':<18} {'position':<12} display")
    for display in found:
        connector = connector_of(display)
        mark = "*" if configured and connectors_match(connector, configured) else " "
        mode = f"{display['w']}x{display['h']}@{display['refresh']}Hz"
        position = f"+{display['x']}+{display['y']}"
        print(f"{mark} {display['index']:<3} {connector:<12} {mode:<18} "
              f"{position:<12} {display.get('model') or display['name']}")
    if not configured and not args.no_hint:
        print("\n  no display saved yet. Pick one with: cachy-console settings")
    elif configured and not any(
            connectors_match(connector_of(d), configured) for d in found):
        print(f"\n  saved display {configured} is currently off. "
              "Console mode will wait for it rather than use another screen.")
    return 0


def cmd_resolve(args):
    display = pick(args.name, allow_index=bool(args.name and str(args.name).isdigit()))
    config = read_config()

    # --strict is for the moment before a session starts, where being told to wait
    # is more useful than being given an index that means nothing.
    if getattr(args, "strict", False):
        current = displays()
        stacked = stacked_displays(current)
        if stacked:
            names = ", ".join(connector_of(entry) for entry in stacked)
            raise DisplayError(
                f"displays are still arranging themselves ({names} report the "
                "same position)")
        if any(entry.get("disputed") for entry in current):
            raise DisplayError(
                "the two views of the screens do not line up, so the mode of "
                "each one is still unknown")

    width = display["w"]
    height = display["h"]
    refresh = display["refresh"]

    # An explicit override in the config wins, for the rare panel whose
    # advertised mode is not the one the user wants to game at.
    override = config.get("RESOLUTION", "auto")
    if override and override.lower() != "auto" and "x" in override:
        try:
            width, height = (int(v) for v in override.lower().split("x", 1))
        except ValueError:
            pass
    override = config.get("REFRESH", "auto")
    if override and override.lower() != "auto":
        try:
            refresh = int(float(override))
        except ValueError:
            pass

    if not refresh:
        refresh = 60          # gamescope needs a number; 60 is the safe floor

    if args.json:
        print(json.dumps({"index": display["index"], "width": width,
                          "height": height, "refresh": refresh,
                          "connector": connector_of(display),
                          "name": display["name"]}))
    else:
        print(f"{display['index']} {width} {height} {refresh} "
              f"{connector_of(display)}")
    return 0


def cmd_has(args):
    try:
        pick(args.name, allow_index=bool(args.name and str(args.name).isdigit()))
    except DisplayError:
        return 1
    return 0


def cmd_saved(args):
    saved = saved_connector()
    if not saved:
        print("(none)")
        return 1
    print(saved)
    return 0


def cmd_set(args):
    connector = args.connector.strip()
    if not connector or connector.lower() == "auto" or connector.isdigit():
        raise DisplayError("save a connector name (HDMI-1), not auto or an index")
    model = ""
    try:
        for display in displays():
            if connectors_match(connector_of(display), connector):
                connector = connector_of(display)   # live name gamescope will see
                model = display.get("model") or display["name"]
                break
    except DisplayError:
        pass
    # Saving is allowed while the display is off: that is the whole point of
    # remembering a connector instead of "whatever is plugged in right now".
    update_config({"DISPLAY": connector, "DISPLAY_MODEL": model})
    print(f"saved {connector}" + (f" ({model})" if model else ""))
    return 0


def cmd_config_set(args):
    """Patch KEY=VALUE pairs without rewriting the rest of the file."""
    updates = {}
    for item in args.assignments:
        if "=" not in item:
            raise DisplayError(f"not KEY=VALUE: {item}")
        key, _, value = item.partition("=")
        key = key.strip()
        if not key:
            raise DisplayError(f"not KEY=VALUE: {item}")
        updates[key] = value
    update_config(updates)
    return 0


def cmd_probe(args):
    for driver in ([args.driver] if args.driver else ["x11", "wayland"]):
        print(f"== SDL_VIDEODRIVER={driver} ==")
        found = enumerate_sdl(driver)
        if not found:
            print("   unavailable in this session")
            continue
        for display in found:
            print(f"   index {display['index']}: {display['name'] or '?':<28} "
                  f"{display['w']}x{display['h']}@{display['refresh']}Hz "
                  f"at +{display['x']}+{display['y']}")
    return 0


AUDIO_STATE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "cachy-console-audio-route.json")

_STOPWORDS = {
    "hdmi", "displayport", "digital", "stereo", "audio", "corporation",
    "electric", "company", "lcd", "the", "and",
}


def _tokens(text):
    return {t for t in re.findall(r"[a-z0-9]+", (text or "").lower())
            if len(t) > 2 and t not in _STOPWORDS}


def _pactl_json(what):
    out = run(["pactl", "-f", "json", "list", what], timeout=8)
    if not out:
        return []
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


def _pactl(*args):
    return run(["pactl", *args], timeout=8)


def hdmi_ports():
    """HDMI/DP ports on ALSA cards, with ELD monitor names and profiles."""
    found = []
    for card in _pactl_json("cards"):
        ports = card.get("ports") or {}
        if not isinstance(ports, dict):
            continue
        for pname, port in ports.items():
            if not isinstance(port, dict):
                continue
            if (port.get("type") or "").upper() != "HDMI" and "hdmi" not in pname.lower():
                continue
            props = port.get("properties") or {}
            profiles = [p for p in (port.get("profiles") or [])
                        if str(p).startswith("output:") and "stereo" in str(p)]
            if not profiles:
                profiles = [p for p in (port.get("profiles") or [])
                            if str(p).startswith("output:")]
            found.append({
                "card": card.get("name"),
                "card_profile": card.get("active_profile"),
                "port": pname,
                "eld": props.get("device.product.name") or "",
                "available": str(port.get("availability") or "").lower() == "available",
                "profile": profiles[0] if profiles else None,
            })
    return found


def score_port(port, model, connector):
    if not port.get("available") or not port.get("profile"):
        return 0
    eld = port.get("eld") or ""
    overlap = _tokens(eld) & (_tokens(model) | _tokens(connector))
    if overlap:
        return 10 + len(overlap)
    eld_l, model_l = eld.lower(), (model or "").lower()
    if eld_l and model_l and (eld_l in model_l or model_l in eld_l):
        return 5
    return 0


def match_hdmi(connector=None, model=None):
    """The HDMI audio profile for the saved (or named) display, or None."""
    connector = connector or saved_connector()
    if not connector:
        return None
    if not model:
        model = (read_config().get("DISPLAY_MODEL") or "").strip()
        try:
            for display in displays():
                if connector_of(display).lower() == connector.lower():
                    model = display.get("model") or display["name"] or model
                    break
        except DisplayError:
            pass
    best, best_score = None, 0
    for port in hdmi_ports():
        sc = score_port(port, model, connector)
        if sc > best_score:
            best, best_score = port, sc
    return best


def saved_audio_device():
    """The audio output the user saved, or None to follow the display."""
    raw = (read_config().get("AUDIO_DEVICE") or "").strip()
    return raw or None


def _name_matches(wanted, *names):
    w = (wanted or "").strip().lower()
    if not w:
        return False
    for name in names:
        n = (name or "").strip().lower()
        if n and n == w:
            return True
    tokens = _tokens(wanted)
    if not tokens:
        return False
    return any(tokens & _tokens(name) for name in names if name)


def _sink_labels(sink):
    props = sink.get("properties") or {}
    return [x for x in (
        sink.get("name"),
        props.get("node.nick"),
        props.get("node.description"),
        props.get("device.description"),
        props.get("device.product.name"),
    ) if x]


def audio_choices():
    """HDMI monitors (by ELD) plus USB/analog sinks the user can save."""
    choices = []
    hdmi_cards = set()
    for port in hdmi_ports():
        card = port.get("card") or ""
        if card:
            hdmi_cards.add(card.replace("alsa_card.", "alsa_output.", 1))
        if not port.get("available") or not port.get("profile"):
            continue
        label = (port.get("eld") or "").strip() or port["port"]
        choices.append({
            "id": label,
            "label": label,
            "kind": "hdmi",
            "detail": "HDMI",
            "port": port,
        })
    seen = {c["id"].lower() for c in choices}
    for sink in _sinks():
        name = sink.get("name") or ""
        if any(name.startswith(prefix) for prefix in hdmi_cards):
            continue
        props = sink.get("properties") or {}
        label = (props.get("node.nick") or props.get("node.description") or name)
        if not label or label.lower() in seen:
            continue
        seen.add(label.lower())
        choices.append({
            "id": label,
            "label": label,
            "kind": "sink",
            "detail": "device",
            "sink": name,
        })
    return choices


def match_saved_audio(wanted):
    """Resolve a saved AUDIO_DEVICE name to an HDMI port or a Pulse sink."""
    wanted = (wanted or "").strip()
    if not wanted:
        return None
    for port in hdmi_ports():
        if not port.get("available") or not port.get("profile"):
            continue
        if _name_matches(wanted, port.get("eld"), port.get("port")):
            return dict(port, kind="hdmi")
    for sink in _sinks():
        if _name_matches(wanted, *_sink_labels(sink)):
            props = sink.get("properties") or {}
            return {
                "kind": "sink",
                "sink": sink.get("name"),
                "eld": props.get("node.nick") or props.get("node.description") or wanted,
            }
    return None


def sink_for(target):
    """The Pulse sink a resolved audio target plays through, if there is one yet.

    A saved AUDIO_DEVICE usually resolves to an HDMI port rather than a sink, and
    that is the shape the routing wants: sending sound to a TV means setting the
    card's profile, not picking a sink. Anything that has to name a destination
    for one stream needs the sink instead -- pinning voice chat does -- and the
    sink only exists once that profile is active, so this answers None rather than
    guessing when it is not.
    """
    if not target:
        return None
    if target.get("sink"):
        return target["sink"]
    # A card's sinks are named after the card and the profile that created them:
    # profile output:hdmi-stereo-extra3 on alsa_card.pci-0000_0c_00.1 gives the
    # sink alsa_output.pci-0000_0c_00.1.hdmi-stereo-extra3. Matching on both is
    # exact, where a name alone is only ever a guess.
    card = (target.get("card") or "").split(".", 1)[-1]
    profile = (target.get("profile") or "").split(":", 1)[-1]
    if card and profile:
        for sink in _sinks():
            name = sink.get("name") or ""
            if card in name and name.endswith(profile):
                return name
    # For a card that does not name its sinks that way, the ELD is what the user
    # chose in the settings window and what the sink is likely to be nicked.
    eld = target.get("eld") or ""
    if eld:
        for sink in _sinks():
            if _name_matches(eld, *_sink_labels(sink)):
                return sink.get("name")
    return None


def match_audio():
    """The audio output console mode should use.

    A saved AUDIO_DEVICE wins and is not replaced by the display. If nothing
    is saved, the HDMI port whose ELD matches the saved display is used.
    """
    wanted = saved_audio_device()
    if wanted:
        return match_saved_audio(wanted)
    hit = match_hdmi()
    if hit:
        return dict(hit, kind="hdmi")
    return None


def _default_sink():
    out = _pactl("get-default-sink")
    return (out or "").strip() or None


def _sinks():
    return _pactl_json("sinks")


def _sources():
    """Real capture devices only.

    PipeWire publishes a .monitor source for every sink, which is a loopback of
    output rather than a microphone, and offering those as input choices would
    be actively confusing.
    """
    out = []
    for source in _sources_raw():
        props = source.get("properties") or {}
        name = source.get("name") or ""
        if (props.get("device.class") or "").lower() == "monitor":
            continue
        if name.endswith(".monitor") or source.get("monitor_of_sink"):
            continue
        out.append(source)
    return out


def _sources_raw():
    return _pactl_json("sources")


def _source_labels(source):
    props = source.get("properties") or {}
    return [x for x in (
        source.get("name"),
        props.get("node.nick"),
        props.get("node.description"),
        props.get("device.description"),
        props.get("device.product.name"),
    ) if x]


def saved_audio_input_device():
    """The microphone the user saved, or None to leave input alone."""
    raw = (read_config().get("AUDIO_INPUT_DEVICE") or "").strip()
    return raw or None


def audio_input_choices():
    """Microphones the user can save for console mode."""
    choices = []
    seen = set()
    for source in _sources():
        name = source.get("name") or ""
        props = source.get("properties") or {}
        label = (props.get("node.nick") or props.get("node.description")
                 or props.get("device.description") or name)
        if not label or label.lower() in seen:
            continue
        seen.add(label.lower())
        choices.append({
            "id": label,
            "label": label,
            "kind": "source",
            "detail": "microphone",
            "source": name,
        })
    return choices


def match_audio_input():
    """The PipeWire source console mode should use, or None to leave it alone.

    Nothing saved means input is untouched: unlike HDMI output, a microphone
    does not need a profile switch to become usable, so there is no reason to
    guess at one on the user's behalf.
    """
    wanted = saved_audio_input_device()
    if not wanted:
        return None
    for source in _sources():
        if _name_matches(wanted, *_source_labels(source)):
            return source.get("name")
    return None


def _load_audio_state():
    try:
        with open(AUDIO_STATE) as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError):
        return None


def _save_audio_state(state):
    os.makedirs(os.path.dirname(AUDIO_STATE) or ".", exist_ok=True)
    with open(AUDIO_STATE, "w") as fh:
        json.dump(state, fh)


def _drop_audio_state():
    try:
        os.remove(AUDIO_STATE)
    except OSError:
        pass


def _sink_matches(sink, target):
    name = sink.get("name") or ""
    prefix = (target.get("card") or "").replace("alsa_card.", "alsa_output.", 1)
    suffix = (target.get("profile") or "").replace("output:", "", 1)
    if prefix and name.startswith(prefix):
        return True
    if suffix and name.endswith(suffix):
        return True
    props = sink.get("properties") or {}
    nick = (props.get("node.nick") or props.get("device.product.name") or "")
    eld = (target.get("eld") or "").lower()
    return bool(eld and eld in nick.lower())


def _pw_run(args, timeout=8):
    return run(args, timeout=timeout)


WP_RULE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "wireplumber", "wireplumber.conf.d", "51-cachy-console-display.conf")


def _write_wp_rule(sink_name, eld):
    """So the next time this HDMI node is created it is already named
    after the TV, not 'Navi 31 HDMI/DP Audio'."""
    if not sink_name or not eld:
        return
    safe_eld = eld.replace("\\", "").replace('"', "")
    safe_name = sink_name.replace("\\", "").replace('"', "")
    body = (
        "monitor.alsa.rules = [\n"
        "  {\n"
        "    matches = [\n"
        "      { node.name = \"%s\" }\n"
        "    ]\n"
        "    actions = {\n"
        "      update-props = {\n"
        "        node.description = \"%s\"\n"
        "        node.nick = \"%s\"\n"
        "        device.description = \"%s\"\n"
        "      }\n"
        "    }\n"
        "  }\n"
        "]\n" % (safe_name, safe_eld, safe_eld, safe_eld)
    )
    try:
        os.makedirs(os.path.dirname(WP_RULE), exist_ok=True)
        with open(WP_RULE, "w") as fh:
            fh.write(body)
    except OSError:
        pass


def _drop_wp_rule():
    try:
        os.remove(WP_RULE)
    except OSError:
        pass


def _label_sink(name, eld):
    """Steam shows node.description, which PipeWire sets to the GPU card
    ('Navi 31 HDMI/DP Audio') even when this port is the TV. Rename it."""
    if not name or not eld:
        return
    _write_wp_rule(name, eld)
    nid = None
    for sink in _sinks():
        if sink.get("name") == name:
            props = sink.get("properties") or {}
            nid = props.get("object.id")
            break
    if nid is None:
        return
    safe = eld.replace("\\", "").replace('"', "")
    # PipeWire's pactl has no update-sink-proplist. Metadata + set-param
    # are what actually change the name Steam reads.
    _pw_run(["pw-metadata", str(nid), "node.description", safe])
    _pw_run(["pw-metadata", str(nid), "device.description", safe])
    _pw_run(["pw-cli", "set-param", str(nid), "Props",
             "{ node.description = \"%s\" }" % safe])


def _sink_inputs():
    return _pactl_json("sink-inputs")


def _move_sink_inputs(name):
    """Existing streams stay on the old sink after a default change; move them."""
    if not name:
        return
    for inp in _sink_inputs():
        idx = inp.get("index")
        if idx is None:
            continue
        _pactl("move-sink-input", str(idx), name)


def _set_configured_sink(name):
    if not name:
        return
    payload = '{"name":"%s"}' % name.replace("\\", "").replace('"', "")
    _pw_run(["pw-metadata", "-n", "settings", "0",
             "default.configured.audio.sink", payload])


def _apply_named_sink(name, eld, rename=False):
    if not name:
        return None
    _pactl("set-default-sink", name)
    _move_sink_inputs(name)
    _set_configured_sink(name)
    if rename and eld:
        _label_sink(name, eld)
    print(f"SINK {name}")
    print(f"audio -> {eld or name} ({name})")
    return name


def _apply_console_sink(target):
    """Make the saved display the default HDMI device and name it for Steam."""
    for _ in range(10):
        for sink in _sinks():
            if not _sink_matches(sink, target):
                continue
            name = sink.get("name") or ""
            eld = target.get("eld") or "Console display"
            _pactl("set-default-sink", name)
            _move_sink_inputs(name)
            _set_configured_sink(name)
            _label_sink(name, eld)
            print(f"SINK {name}")
            print(f"HDMI audio -> {eld} ({name})")
            return name
        time.sleep(0.1)
    return None


def cmd_audio_list(args):
    cfg = read_config()
    saved = saved_connector() or ""
    model = (cfg.get("DISPLAY_MODEL") or "").strip()
    saved_dev = saved_audio_device() or ""
    target = match_audio()
    print(f"  saved display: {saved or '(none)'} {('('+model+')') if model else ''}")
    print(f"  saved audio:   {saved_dev or '(follows display)'}")
    print("  audio outputs:")
    for choice in audio_choices():
        mark = " "
        if target and choice["kind"] == "hdmi":
            port = choice.get("port") or {}
            if (target.get("kind") != "sink"
                    and port.get("port") == target.get("port")
                    and port.get("card") == target.get("card")):
                mark = "*"
        elif target and choice["kind"] == "sink" and target.get("kind") == "sink":
            if choice.get("sink") == target.get("sink"):
                mark = "*"
        extra = choice.get("detail") or ""
        print(f"  {mark} {choice['label']:22} {extra}")
    print("  HDMI audio ports:")
    for port in hdmi_ports():
        mark = "*" if (target and target.get("kind") != "sink"
                       and port["port"] == target.get("port")
                       and port["card"] == target.get("card")) else " "
        avail = "on" if port["available"] else "off"
        print(f"  {mark} {port['eld'] or '(no ELD)':22} {avail:3}  "
              f"{port['profile'] or '-':28} {port['port']}")
    if not target:
        if saved_dev:
            print(f"  saved audio {saved_dev} is not available right now.")
        elif saved:
            print("  no HDMI audio matched that display "
                  "(it may not expose audio, or the port is off).")
    return 0


def cmd_audio_set(args):
    name = (args.device or "").strip()
    if not name:
        print("cachy-console-display: pick an audio output", file=sys.stderr)
        return 2
    update_config({"AUDIO_DEVICE": name})
    print(f"saved audio: {name}")
    return 0


def cmd_audio_input_list(args):
    saved = saved_audio_input_device() or ""
    resolved = match_audio_input()
    print(f"  saved microphone: {saved or '(session default)'}")
    print("  microphones:")
    choices = audio_input_choices()
    for choice in choices:
        mark = "*" if resolved and choice.get("source") == resolved else " "
        print(f"  {mark} {choice['label']:28} {choice['detail']}")
    if not choices:
        print("    (none found)")
    if saved and not resolved:
        print(f"  saved microphone {saved} is not available; console mode will "
              f"use the session default.")
    return 0


def cmd_audio_input_set(args):
    name = (args.device or "").strip()
    update_config({"AUDIO_INPUT_DEVICE": name})
    print(f"saved microphone: {name or '(session default)'}")
    return 0


def cmd_audio_resolve(args):
    """The sink name console mode should play through, without switching to it.

    The read-only half of audio-route, for callers that need to know the target
    but must not change the profile -- the audio daemon pins streams to it while
    a session is running, and switching underneath a running session would be a
    side effect nobody asked for.
    """
    name = sink_for(match_audio())
    if name:
        print(name)
    return 0


def cmd_audio_input_resolve(args):
    """The source name for PULSE_SOURCE, or nothing to leave input alone."""
    name = match_audio_input()
    if name:
        print(name)
    return 0


# ---- controllers --------------------------------------------------------

def gamepads():
    """Every gamepad the kernel is presenting, in the order it numbered them.

    Read from sysfs rather than through SDL, so that merely listing controllers
    does not start a joystick subsystem or open the devices out from under
    whatever is using them. The js number is the whole point of the list: a
    game assigns players in this order, so a device sitting on js0 is player
    one whether or not it ever sends an event.
    """
    found = []
    for node in glob.glob("/sys/class/input/js*"):
        digits = re.sub(r"\D", "", os.path.basename(node))
        device = os.path.dirname(os.path.realpath(node))

        def attr(name):
            try:
                with open(os.path.join(device, name)) as fh:
                    return fh.read().strip()
            except OSError:
                return ""

        found.append({
            "js": os.path.basename(node),
            "index": int(digits) if digits else 0,
            "name": attr("name") or "(unnamed)",
            "vendor": attr("id/vendor").lower(),
            "product": attr("id/product").lower(),
            "virtual": "/devices/virtual/" in os.path.realpath(node),
        })
    found.sort(key=lambda pad: pad["index"])
    return found


def steam_controller_asleep():
    """A Valve wireless dongle present with no controller talking to it.

    Worth singling out because a Steam Controller turns itself off after a few
    minutes and takes the trackpad with it, and nothing about that is visible
    from the couch: Big Picture is still on screen, the Steam keyboard still
    types -- Steam drives that from the client -- and the trackpad is simply
    dead, which looks exactly like the pointer being broken.

    The tell is the dongle's own input devices. The kernel gives every slot a
    mouse and a keyboard for the controller's built-in emulation, and Steam
    replaces those with a virtual pad for any controller it has taken over. A
    dongle with no virtual pad beside it has nothing connected to it.
    """
    try:
        with open("/proc/bus/input/devices") as fh:
            blocks = fh.read().split("\n\n")
    except OSError:
        return False
    dongle = any("Steam Controller" in b and "Vendor=28de" in b for b in blocks)
    return dongle and not any(pad["virtual"] for pad in gamepads())


def saved_ignored_controllers():
    """The raw IGNORE_CONTROLLERS setting, in SDL's own id format."""
    return (read_config().get("IGNORE_CONTROLLERS") or "").strip()


def ignored_pairs(raw):
    """Parse "0x31e3/0x1400, 0x28de/0x1205" into {(vendor, product)}.

    Padded to four hex digits because sysfs reports ids that way while people
    write them either way, so "0x3e3/0x400" still matches.
    """
    pairs = set()
    for item in (raw or "").replace(";", ",").split(","):
        vendor, sep, product = item.strip().lower().partition("/")
        if not sep:
            continue
        vendor = vendor.strip().removeprefix("0x").zfill(4)
        product = product.strip().removeprefix("0x").zfill(4)
        if vendor and product:
            pairs.add((vendor, product))
    return pairs


def cmd_controllers(args):
    raw = saved_ignored_controllers()
    ignored = ignored_pairs(raw)
    print(f"  hidden from console mode: {raw or '(nothing)'}")
    print("  gamepads:")
    pads = gamepads()
    for pad in pads:
        if pad["vendor"] and pad["product"]:
            ident = f"0x{pad['vendor']}/0x{pad['product']}"
        else:
            ident = "(no usb id)"
        mark = "-" if (pad["vendor"], pad["product"]) in ignored else " "
        kind = "  virtual" if pad["virtual"] else ""
        print(f"  {mark} {pad['js']:4} {ident:16} {pad['name']}{kind}")
    if not pads:
        print("    (none connected)")
    print("  '-' marks one IGNORE_CONTROLLERS hides. A virtual pad is what")
    print("  Steam Input presents for a controller it has taken over.")
    if steam_controller_asleep():
        print("  A Steam Controller receiver is plugged in with nothing connected")
        print("  to it, so the trackpad will not move a cursor anywhere. Press the")
        print("  controller's Steam button to wake it -- it sleeps by itself. If")
        print("  that changes nothing, it is flat or no longer paired; a USB-C")
        print("  cable both charges it and connects it without the receiver.")
    return 0


# IGNORE_CONTROLLERS reaches Steam, but not the games it starts: Steam replaces
# SDL_GAMECONTROLLER_IGNORE_DEVICES in a game's environment with its own list,
# and that list is the only per-device filter Proton's input bus has. So a
# keyboard's gamepad mode stays a controller to every Proton game. Where that
# gamepad is its own Xbox-protocol USB interface -- vendor class ff, subclass
# 5d (Xbox 360) or 47 (Xbox One) -- udev can switch off that interface alone,
# which removes the pad from everything while the keyboard's HID interfaces
# carry on typing.
UDEV_RULES = "/etc/udev/rules.d/70-cachy-console-hide-controllers.rules"
XBOX_SUBCLASSES = ("5d", "47")
USB_DEVICES = os.environ.get("CACHY_CONSOLE_USB_DEVICES", "/sys/bus/usb/devices")


def hide_rules(pairs):
    """The udev rules for pairs, or "" when there is nothing to hide."""
    if not pairs:
        return ""
    lines = ["# Written by cachy-console hide-controllers from IGNORE_CONTROLLERS.",
             "# Switches off only the Xbox-protocol interface, so a keyboard keeps typing."]
    for vendor, product in sorted(pairs):
        lines.append(
            'ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", '
            f'ATTRS{{idVendor}}=="{vendor}", ATTRS{{idProduct}}=="{product}", '
            'ATTR{bInterfaceClass}=="ff", '
            f'ATTR{{bInterfaceSubClass}}=="{"|".join(XBOX_SUBCLASSES)}", '
            'ATTR{authorized}="0"')
    return "\n".join(lines) + "\n"


def xbox_interfaces():
    """[(interface dir, (vendor, product), authorized)] for every connected
    Xbox-protocol USB interface."""
    def read(path):
        try:
            with open(path) as fh:
                return fh.read().strip().lower()
        except OSError:
            return ""

    found = []
    for iface in sorted(glob.glob(os.path.join(USB_DEVICES, "*:*"))):
        if read(os.path.join(iface, "bInterfaceClass")) != "ff":
            continue
        if read(os.path.join(iface, "bInterfaceSubClass")) not in XBOX_SUBCLASSES:
            continue
        device = os.path.join(USB_DEVICES, os.path.basename(iface).split(":")[0])
        ids = (read(os.path.join(device, "idVendor")), read(os.path.join(device, "idProduct")))
        found.append((iface, ids, read(os.path.join(iface, "authorized")) != "0"))
    return found


def cmd_hide_rules(args):
    sys.stdout.write(hide_rules(ignored_pairs(saved_ignored_controllers())))
    return 0


def cmd_hide_interfaces(args):
    """Interfaces to switch off now (or, with --restore, back on): listed ones
    still on, or unlisted ones a previous list switched off."""
    ignored = ignored_pairs(saved_ignored_controllers())
    for iface, ids, on in xbox_interfaces():
        listed = ids in ignored
        if (args.restore and not listed and not on) or (not args.restore and listed and on):
            print(iface)
    return 0


# Right trackpad moves the pointer and clicks when pressed, right trigger is a
# left click, left trigger a right click, left trackpad scrolls.
MOUSE_TEMPLATE = "controller_neptune_webbrowser.vdf"


def steam_root():
    for path in ("~/.local/share/Steam", "~/.steam/steam"):
        path = os.path.expanduser(path)
        if os.path.isdir(os.path.join(path, "userdata")):
            return path
    return None


def read_binary_vdf(data):
    """Steam's binary KeyValues, as in shortcuts.vdf, into nested dicts."""
    pos = 0

    def cstring():
        nonlocal pos
        end = data.index(b"\0", pos)
        text = data[pos:end].decode("utf-8", "replace")
        pos = end + 1
        return text

    def node():
        nonlocal pos
        out = {}
        while pos < len(data):
            kind = data[pos]
            pos += 1
            if kind == 0x08:
                return out
            key = cstring()
            if kind == 0x00:
                out[key] = node()
            elif kind == 0x01:
                out[key] = cstring()
            elif kind == 0x02:
                out[key] = int.from_bytes(data[pos:pos + 4], "little")
                pos += 4
            elif kind == 0x07:
                out[key] = int.from_bytes(data[pos:pos + 8], "little")
                pos += 8
            else:
                raise ValueError(f"unknown binary vdf type {kind:#x}")
        return out

    return node()


def steam_shortcuts(path):
    """[(appid, name)] for the non-Steam games in a shortcuts.vdf."""
    try:
        with open(path, "rb") as fh:
            tree = read_binary_vdf(fh.read())
    except (OSError, ValueError, IndexError):
        return []
    found = []
    for entry in (tree.get("shortcuts") or {}).values():
        if not isinstance(entry, dict):
            continue
        fields = {k.lower(): v for k, v in entry.items()}
        if isinstance(fields.get("appid"), int) and fields.get("appname"):
            found.append((fields["appid"], fields["appname"]))
    return found


def read_text_vdf(text):
    """Steam's text KeyValues into nested dicts, keeping the order of keys."""
    tokens = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text)
    pos = 0

    def node():
        nonlocal pos
        out = {}
        while pos < len(tokens):
            key, brace = tokens[pos]
            pos += 1
            if brace == "}":
                return out
            if pos >= len(tokens):
                break
            value, brace = tokens[pos]
            pos += 1
            out[key] = node() if brace == "{" else value
        return out

    return node()


def write_text_vdf(tree, depth=0):
    pad = "\t" * depth
    lines = []
    for key, value in tree.items():
        if isinstance(value, dict):
            lines += [f'{pad}"{key}"', pad + "{",
                      write_text_vdf(value, depth + 1) + pad + "}"]
        else:
            lines.append(f'{pad}"{key}"\t\t"{value}"')
    return "".join(line + "\n" for line in lines)


def mouse_apps():
    """Names and appids from MOUSE_LAYOUT_APPS, Discord and Spotify unless set."""
    raw = read_config().get("MOUSE_LAYOUT_APPS")
    if raw is None:
        raw = "Discord, Spotify"
    return [item.strip() for item in raw.split(",") if item.strip()]


def steam_controller_configsets(config_dir):
    """configset files that decide layouts for the Steam Controller.

    Steam names every pad "Steam Controller" in these files, DualSense included,
    so the name says nothing. Only the Steam Controller's own preferences carry
    its trackpad and gyro calibration under Valve's name for it, triton. The
    per-type file covers one Steam has not seen yet.
    """
    found = []
    for prefs in sorted(glob.glob(os.path.join(config_dir, "preferences_*.vdf"))):
        try:
            with open(prefs, errors="replace") as fh:
                if "triton" not in fh.read():
                    continue
        except OSError:
            continue
        serial = os.path.basename(prefs)[len("preferences_"):]
        found.append(os.path.join(config_dir, "configset_" + serial))
    found.append(os.path.join(config_dir, "configset_controller_triton.vdf"))
    return found


def shortcut_layout_key(name):
    """How configset files name a non-Steam shortcut: not by its appid, which
    Steam ignores there, but lowercased with punctuation dropped, as in its own
    "ea app" and "zshadercachekillersh" (from zShaderCacheKiller.sh)."""
    return re.sub(r"[^a-z0-9 ]", "", name.lower())


def set_mouse_layouts(root, wanted, dry_run=False):
    """Give each wanted shortcut a mouse layout where none was chosen.

    Returns a line per change or refusal. Steam keeps these files in memory and
    writes them back when it exits, so this only sticks while Steam is closed.
    """
    report = []
    configs = os.path.join(root, "steamapps", "common", "Steam Controller Configs")
    for account in sorted(glob.glob(os.path.join(root, "userdata", "*"))):
        config_dir = os.path.join(configs, os.path.basename(account), "config")
        if not os.path.isdir(config_dir):
            continue
        shortcuts = steam_shortcuts(os.path.join(account, "config", "shortcuts.vdf"))
        apps = []
        for item in wanted:
            for appid, name in shortcuts:
                if item.lower() == name.lower() or item == str(appid):
                    apps.append((appid, name))
        if not apps:
            continue
        for path in steam_controller_configsets(config_dir):
            try:
                with open(path, errors="replace") as fh:
                    tree = read_text_vdf(fh.read())
            except FileNotFoundError:
                tree = {}
            except OSError as exc:
                report.append(f"cannot read {path}: {exc}")
                continue
            layouts = tree.setdefault("controller_config", {})
            changed = False
            for appid, name in apps:
                key = shortcut_layout_key(name)
                if not key or key in layouts:
                    continue
                layouts[key] = {"template": MOUSE_TEMPLATE}
                changed = True
                report.append(f"{name} ({appid}): trackpad mouse layout in "
                              f"{os.path.basename(path)}")
            if changed and not dry_run:
                tmp = path + ".tmp"
                with open(tmp, "w") as fh:
                    fh.write(write_text_vdf(tree))
                os.replace(tmp, path)
    return report


def cmd_pad_layouts(args):
    root = steam_root()
    if not root:
        return 0
    for line in set_mouse_layouts(root, mouse_apps(), args.dry_run):
        print(("would set " if args.dry_run else "") + line)
    return 0


def _remember_restore_state(target):
    previous_sink = _default_sink()
    previous_profile = target.get("card_profile")
    existing = _load_audio_state()
    # A crashed session may already have switched the profile. Keep the
    # original desktop device so the next restore still lands there.
    if existing and existing.get("applied"):
        if not target.get("card") or existing.get("card") == target.get("card"):
            previous_profile = existing.get("previous_profile") or previous_profile
            previous_sink = existing.get("previous_sink") or previous_sink
    _save_audio_state({
        "card": target.get("card"),
        "previous_profile": previous_profile,
        "previous_sink": previous_sink,
        "applied": True,
        "eld": target.get("eld"),
        "profile": target.get("profile"),
    })


def _route_sink(args, target):
    name = target.get("sink")
    eld = target.get("eld") or name
    if args.dry_run:
        print(f"would set default sink to {name} ({eld})")
        return 0
    _remember_restore_state(target)
    if _apply_named_sink(name, eld, rename=False) is None:
        print(f"could not switch audio to {eld}", file=sys.stderr)
        return 1
    return 0


def _route_hdmi(args, target):
    """Point the GPU HDMI profile at the saved output so Steam can list it."""
    if args.dry_run:
        if target["card_profile"] == target["profile"]:
            print(f"would keep {target['card']} on {target['profile']} "
                  f"({target['eld']})")
        else:
            print(f"would set {target['card']} to {target['profile']} "
                  f"({target['eld']})")
        return 0

    if target["card_profile"] == target["profile"]:
        print(f"HDMI audio already on {target['eld']} ({target['profile']})")
        _apply_console_sink(target)
        return 0

    _remember_restore_state(target)
    # Name the node before it appears, so Steam never sees the GPU card name.
    _write_wp_rule(
        target["card"].replace("alsa_card.", "alsa_output.", 1)
        + "." + target["profile"].replace("output:", ""),
        target.get("eld") or "")
    if _pactl("set-card-profile", target["card"], target["profile"]) is None:
        print(f"could not switch HDMI audio to {target['eld']}", file=sys.stderr)
        return 1
    if _apply_console_sink(target) is None:
        print(f"switched profile to {target['profile']}; default sink not found yet")
    return 0


def cmd_audio_route(args):
    """Point console-mode audio at the saved device, or the saved display."""
    target = match_audio()
    if not target:
        print("no audio device matched; leaving audio alone")
        return 0
    if target.get("kind") == "sink" or not target.get("profile"):
        return _route_sink(args, target)
    return _route_hdmi(args, target)


def cmd_audio_restore(args):
    state = _load_audio_state()
    if not state:
        return 0
    if not state.get("applied"):
        _drop_audio_state()
        return 0
    if args.dry_run:
        print(f"would restore {state.get('card')} to {state.get('previous_profile')}")
        return 0
    card = state.get("card")
    profile = state.get("previous_profile")
    if card and profile:
        _pactl("set-card-profile", card, profile)
    sink = state.get("previous_sink")
    if sink:
        _pactl("set-default-sink", sink)
    _drop_audio_state()
    _drop_wp_rule()
    print(f"restored HDMI audio to {profile}")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("list", help="every display and its mode")
    p.add_argument("--json", action="store_true")
    p.add_argument("--no-hint", action="store_true",
                   help="skip the 'run setup' suggestion, for use during setup")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("resolve", help="the display to run console mode on")
    p.add_argument("name", nargs="?")
    p.add_argument("--json", action="store_true")
    p.add_argument("--strict", action="store_true",
                   help="fail while the arrangement of screens is still changing")
    p.set_defaults(func=cmd_resolve)

    p = sub.add_parser("has", help="exit 0 if the display is connected")
    p.add_argument("name", nargs="?")
    p.set_defaults(func=cmd_has)

    sub.add_parser("saved", help="print the saved connector, even if it is off") \
        .set_defaults(func=cmd_saved)

    p = sub.add_parser("set", help="save the only display console mode will use")
    p.add_argument("connector")
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("config-set",
                       help="change keys in the config file; leave the rest")
    p.add_argument("assignments", nargs="+", metavar="KEY=VALUE")
    p.set_defaults(func=cmd_config_set)

    p = sub.add_parser("probe", help="raw SDL enumeration, for debugging")
    p.add_argument("--driver")
    p.set_defaults(func=cmd_probe)

    sub.add_parser("audio-list", help="audio outputs and which one is saved") \
        .set_defaults(func=cmd_audio_list)

    p = sub.add_parser("audio-set",
                       help="save the audio output console mode will use")
    p.add_argument("device")
    p.set_defaults(func=cmd_audio_set)

    sub.add_parser("audio-resolve",
                   help="print the sink console mode plays through") \
        .set_defaults(func=cmd_audio_resolve)

    sub.add_parser("audio-input-list",
                   help="microphones and which one is saved") \
        .set_defaults(func=cmd_audio_input_list)

    p = sub.add_parser("audio-input-set",
                       help="save the microphone console mode will use")
    p.add_argument("device", nargs="?", default="",
                   help="omit to go back to the session default")
    p.set_defaults(func=cmd_audio_input_set)

    sub.add_parser("audio-input-resolve",
                   help="print the PipeWire source for PULSE_SOURCE") \
        .set_defaults(func=cmd_audio_input_resolve)

    sub.add_parser("controllers",
                   help="gamepads and which ones console mode hides") \
        .set_defaults(func=cmd_controllers)

    sub.add_parser("hide-rules",
                   help="udev rules that switch off listed controllers' Xbox interfaces") \
        .set_defaults(func=cmd_hide_rules)

    p = sub.add_parser("hide-interfaces",
                       help="connected Xbox interfaces to switch off now")
    p.add_argument("--restore", action="store_true",
                   help="instead, the ones to switch back on")
    p.set_defaults(func=cmd_hide_interfaces)

    p = sub.add_parser("pad-layouts",
                       help="give MOUSE_LAYOUT_APPS a trackpad mouse layout "
                            "(only while Steam is closed)")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_pad_layouts)

    p = sub.add_parser("audio-route",
                       help="switch audio to the saved output")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_audio_route)

    p = sub.add_parser("audio-restore",
                       help="put HDMI audio back after console mode")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_audio_restore)

    args = ap.parse_args()
    try:
        return args.func(args) or 0
    except DisplayError as exc:
        print(f"cachy-console-display: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
