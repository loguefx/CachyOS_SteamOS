#!/usr/bin/env python3
"""Known per-game controller fixes, applied to installed Steam games.

Console mode gets the controller to a game the same way for every title: Steam
Input's virtual pad, shown to Proton games as an Xbox 360 pad. That reaches
almost everything. What it cannot reach is a game whose own input code refuses
a pad that is plainly there -- Assassin's Creed (2008) reads exactly one device,
the one chosen in its Controls menu, starts on the keyboard, and polls and
throws away the pad until someone finds that menu. No session setting fixes
that; a patch to the game does.

Each fix here is one such game and the community patch for it. A fix is only
ever applied:
  - to the exact executables it was made for, checked by hash -- or, where the
    patch's author publishes none, by the same build check the patch makes
    itself -- so a different build of the game is left alone rather than crashed;
  - from downloads pinned by SHA-256, so what lands in the game folder is what
    was checked when the fix was added here;
  - where it would not overwrite a file this did not put there, so another mod
    is never clobbered;
  - while the game is not running, because its Wine prefix's registry is only
    safe to write with nothing holding it.
Everything it adds is recorded, and `remove` takes exactly that back out.

    cachy-console-compat [list]            installed games with a known fix
    cachy-console-compat apply APPID...    apply the fix for these games
    cachy-console-compat apply --all       every installed game with a fix
    cachy-console-compat remove APPID...   take a fix back out
"""

import argparse
import hashlib
import io
import json
import os
import re
import shutil
import struct
import sys
import tempfile
import time
import urllib.request
import zipfile

STEAM_ROOT = os.environ.get("CACHY_CONSOLE_STEAM_ROOT") or os.path.expanduser(
    "~/.local/share/Steam")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME")
                     or os.path.expanduser("~/.local/state"), "cachy-console", "compat")
CACHE = os.environ.get("CACHY_CONSOLE_COMPAT_CACHE") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "cachy-console", "compat")
PROC = os.environ.get("CACHY_CONSOLE_PROC", "/proc")
DOWNLOAD_TIMEOUT = float(os.environ.get("CACHY_CONSOLE_COMPAT_TIMEOUT", "30"))

ULTIMATE_ASI_LOADER = {
    "url": "https://github.com/ThirteenAG/Ultimate-ASI-Loader/releases/download/"
           "v4.68/Ultimate-ASI-Loader.zip",
    "sha256": "7517c7d5bd8c475f18e6545b7998df379eed6e2e0a19fcd2139669152f9bcddb",
    "files": {"dinput8.dll": "dinput8.dll"},
}

# appid -> fix. `exes` are the executables the patch was built for, by MD5 as
# its author publishes them. Where the author publishes no hashes, `signatures`
# are the patch's own build check instead -- the 32-bit value it compares at a
# fixed address before it touches anything -- run here against every .exe in the
# game folder. Only the executables that match get the DLL override, and with
# none matching the fix is not applied at all. `files` maps
# a zip member to where it goes in the game folder. `settings` files are the
# patch's own ini: the player may edit them, so they are neither a conflict to
# re-apply over nor deleted on remove once changed.
FIXES = {
