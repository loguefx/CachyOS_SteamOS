#!/usr/bin/env bash
# cachy-console — a console experience for CachyOS.
#
# Runs Steam Big Picture inside gamescope on the display you choose, at whatever
# resolution and refresh rate that display is already set to. Your desktop keeps
# running on the other monitors; console mode is a thing you switch into and
# back out of, not a different way to boot the machine.
#
#   cachy-console              start console mode
#   cachy-console settings     pick the display and audio console mode uses
#   cachy-console setup        same, from a terminal
#   cachy-console exit         leave console mode, back to the desktop
#   cachy-console status       check the setup and show what would run
#   cachy-console displays     list displays, their modes and gamescope indices
#   cachy-console controllers  list gamepads and the ones console mode hides
#   cachy-console shortcut     add "Exit Console Mode" to your Steam library
#   cachy-console restart-steam  bring the desktop Steam client back
#   cachy-console help
#
# Options:
#   --display NAME    override the configured display for this run
#   --dry-run         print the command instead of running it
#
# Leaving console mode:
#   Steam hides its own "Exit Steam" while it detects gamescope, and Big
#   Picture's "Switch to Desktop" is a SteamOS-only call that does nothing on a
#   normal Linux install, so the way out is `cachy-console exit`, or the
#   "Exit Console Mode" entry that `cachy-console shortcut` puts in your
#   library, which can be clicked with a controller.
#
# Config: ~/.config/cachy-console/config

set -euo pipefail

NAME=cachy-console
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$NAME"
CONFIG_FILE="$CONFIG_DIR/config"

# Defaults, overridden by the config file and then by the command line.
CFG_DISPLAY=auto
CFG_RESOLUTION=auto
CFG_REFRESH=auto
CFG_HDR=off
CFG_VRR=on
CFG_TRACKPAD_FIX=off
CFG_RESTART_STEAM=on
CFG_AUDIO_DEVICE=""
CFG_AUDIO_INPUT_DEVICE=""
CFG_IGNORE_CONTROLLERS=""
CFG_EXTRA_GAMESCOPE_ARGS=""

DRY_RUN=0
DISPLAY_OVERRIDE=""

# A bare soname, so the dynamic linker picks /usr/lib32 for Steam's 32-bit
# client and /usr/lib for its 64-bit children with no arch-mismatch noise.
EXTEST_LIB="${CACHY_CONSOLE_EXTEST:-libextest.so}"

have() { command -v "$1" >/dev/null 2>&1; }
say() { printf '%s\n' "$*"; }
warn() { printf '%s: %s\n' "$NAME" "$*" >&2; }
die() { printf '%s: %s\n' "$NAME" "$*" >&2; exit 1; }
is_on() { [[ "${1,,}" == on || "${1,,}" == yes || "${1,,}" == 1 || "${1,,}" == true ]]; }

usage() {
    awk 'NR == 1 { next }
         /^# Config:/ { sub(/^# ?/, ""); print; exit }
         /^#/ { sub(/^# ?/, ""); print; next }
         { exit }' "$0"
    exit 0
}

# The helpers sit next to this script in a checkout, or on PATH once installed.
find_helper() {
    local wanted="$1" here
    here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -x "$here/$wanted" ]]; then
        printf '%s\n' "$here/$wanted"
    elif have "$wanted"; then
        command -v "$wanted"
    else
        die "cannot find $wanted (is $NAME installed? run ./install.sh)"
    fi
}

# Parsed rather than sourced: a config file should not be able to run commands
# just because someone pasted the wrong thing into it.
load_config() {
    [[ -r "$CONFIG_FILE" ]] || return 0
    local line key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        [[ "$line" == *=* ]] || continue
        key="${line%%=*}"
        value="${line#*=}"
        key="${key//[[:space:]]/}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        value="${value%\"}"; value="${value#\"}"
        value="${value%\'}"; value="${value#\'}"
        case "$key" in
            DISPLAY|DISPLAY_MODEL|RESOLUTION|REFRESH|HDR|VRR|TRACKPAD_FIX|RESTART_STEAM|EXTRA_GAMESCOPE_ARGS|AUDIO_DEVICE|AUDIO_INPUT_DEVICE|IGNORE_CONTROLLERS)
                printf -v "CFG_$key" '%s' "$value" ;;
            STEAM_BUTTON|AUDIO_FOCUS|AUDIO_NEVER_MUTE|AUDIO_PIN_VOICE) ;;   # read by the services, not by us
            "") ;;
            *) warn "ignoring unknown setting in $CONFIG_FILE: $key" ;;
        esac
    done < "$CONFIG_FILE"
}

# ---- display ------------------------------------------------------------

# Fills DISPLAY_INDEX / WIDTH / HEIGHT / REFRESH / CONNECTOR from the helper,
# which reads the mode the display is *currently* set to. That is the whole
# point: whatever you picked in your desktop's display settings -- 1080p60,
# 1440p165, 4K120 -- is what console mode runs at, with nothing to configure.
# Returns non-zero rather than exiting, so `status` can report a display being
# switched off as one finding among many instead of dying halfway through.
resolve_display() {
    local wanted="${DISPLAY_OVERRIDE:-$CFG_DISPLAY}" line
    if ! line="$("$HELPER_DISPLAY" resolve "$wanted" 2>&1)"; then
        # The helper prefixes its own name; keeping it would print two
        # program names in front of one message.
        RESOLVE_ERROR="${line#"$NAME"-display: }"
        return 1
    fi
    read -r DISPLAY_INDEX WIDTH HEIGHT REFRESH CONNECTOR <<<"$line"
    if [[ -z "${DISPLAY_INDEX:-}" ]]; then
        RESOLVE_ERROR="could not work out which display to use"
        return 1
    fi
    return 0
}

# ---- steam --------------------------------------------------------------

steam_running() { pgrep -x steam >/dev/null 2>&1; }

# Every Steam game launch goes through the reaper, so this catches native and
# Proton titles alike.
game_running() { pgrep -f 'SteamLaunch AppId=[0-9]' >/dev/null 2>&1; }

running_appids() {
    pgrep -a -f 'SteamLaunch AppId=[0-9]' 2>/dev/null \
        | grep -o 'AppId=[0-9][0-9]*' | cut -d= -f2 | sort -u | paste -sd' ' -
}

# The same title the watcher matches on, for the same window.
BPM_PATTERN="${CACHY_CONSOLE_BPM_PATTERN:-[Bb]ig ?[Pp]icture}"

big_picture_open() {
    have xprop || return 1
    local wid name
    for wid in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | grep -o '0x[0-9a-f]*'); do
        name="$(xprop -id "$wid" _NET_WM_NAME WM_NAME 2>/dev/null)"
        [[ "$name" =~ $BPM_PATTERN ]] && return 0
    done
    return 1
}

# Get the desktop client out of Big Picture before asking it to quit.
#
# What you see is the reason. The Steam button does not launch anything: it flips
# the *desktop* client into Big Picture, on whatever screen that window was
# already on, and only then does the watcher have anything to react to. That
# window then stays where it is until Steam is gone, so console mode looks like it
# opened on the wrong monitor and moved to the right one some seconds later.
# Leaving Big Picture first puts that screen back to the desktop in about a
# second, instead of it showing the wrong thing for the whole shutdown.
#
# Quitting from the desktop client is a little quicker as well -- measured here,
# 2.7s against 4.6s from Big Picture -- and once took 33s from Big Picture, which
# is the case this is really aimed at.
leave_big_picture() {
    big_picture_open || return 0
    say "Leaving Big Picture on the desktop…"
    steam steam://close/bigpicture >/dev/null 2>&1 || return 0
    local i
    for i in $(seq 1 20); do
        big_picture_open || return 0
        sleep 0.25
    done
    # Not worth waiting on: the shutdown below removes the window regardless.
    return 0
}

stop_steam() {
    steam_running || return 0

    # Restarting Steam takes any running game down with it, so never do that
    # without saying so. Checked before anything else changes.
    if game_running && [[ -z "${CACHY_CONSOLE_FORCE:-}" ]]; then
        die "a game is running (AppID: $(running_appids)) — refusing to restart Steam.
Quit the game first, or set CACHY_CONSOLE_FORCE=1 to override."
    fi

    leave_big_picture

    say "Closing the running Steam client…"
    steam -shutdown >/dev/null 2>&1 || pkill -x steam || true
    local i
    for i in $(seq 1 30); do
        steam_running || return 0
        sleep 1
    done
    warn "Steam ignored the shutdown request; killing it."
    pkill -9 -x steam || true
    sleep 2
}

# One relaunch at a time, and never one racing a session that is starting.
steam_lock_path() { printf '%s\n' "${XDG_RUNTIME_DIR:-/tmp}/$NAME-steam.lock"; }

# Started detached, and in its own transient scope where the user manager can
# make one: the client has to outlive whoever asked for it. This script is about
# to exit, and cachy-console-watch is a systemd service whose control group
# would otherwise own the desktop Steam client -- and collect its log into the
# watcher's journal, where it buries the watcher's own output.
launch_desktop_steam() {
    local plain="${1:-0}"

    # Nothing console mode arranged for the TV may follow Steam back to the
    # desk. PULSE_SINK and PULSE_SOURCE would leave the desktop client playing
    # through the television and listening to the microphone by the couch, and
    # the rest are workarounds for running nested inside gamescope.
    local -a clean=(env
        -u PULSE_SINK -u PULSE_SOURCE
        -u SDL_VIDEODRIVER -u SDL_GAMECONTROLLER_IGNORE_DEVICES
        -u NODEVICE_SELECT -u DISABLE_LAYER_MESA_ANTI_LAG
        -u GDK_BACKEND -u QT_QPA_PLATFORM)

    # Only when the user asked for the preload at all. The desktop is the one
    # place extest is the right answer, but it is still their call, and a
    # preload nobody asked for is a preload nobody can explain.
    extest_wanted && clean+=("LD_PRELOAD=${EXTEST_LIB}${LD_PRELOAD:+:$LD_PRELOAD}")

    # -silent: back to the tray rather than a window thrown over whatever the
    # user returned to. A double press on the Steam button opens Big Picture
    # from the tray just the same, which is the whole reason for bringing it
    # back.
    local -a cmd=("${clean[@]}" steam -silent)

    if (( ! plain )) && have systemd-run; then
        setsid systemd-run --user --quiet --collect --scope -- "${cmd[@]}" \
            >/dev/null 2>&1 < /dev/null &
    else
        setsid "${cmd[@]}" >/dev/null 2>&1 < /dev/null &
    fi
    disown 2>/dev/null || true
}

# Put the ordinary desktop Steam client back after a console session.
#
# Console mode stops the desktop client so Steam can be restarted inside
# gamescope, and leaving takes that Steam down with the compositor, so without
# this the machine is left with no Steam running at all -- and then the Steam
# button has nothing to work on, because a double press does not launch Steam,
# it flips an *already running* client into Big Picture.
#
# Both this script's EXIT trap and cachy-console-watch call it, because which of
# them is still alive depends on how console mode ended: the reaper takes our
# process group down with it when the exit tile is clicked from inside the
# session, and the watcher is not running at all when STEAM_BUTTON is off. The
# lock is what keeps two survivors from starting two clients.
restart_desktop_steam() {
    is_on "$CFG_RESTART_STEAM" || return 0
    have steam || return 0

    # Held for the whole relaunch, and released when this process exits. Without
    # flock there is nothing to arbitrate with, so go ahead unlocked rather than
    # leave the user with no Steam at all.
    if have flock; then
        exec 9>"$(steam_lock_path)" || return 0
        flock -n 9 || return 0
    fi

    local timeout="${CACHY_CONSOLE_STEAM_TIMEOUT:-15}" polls i attempt
    polls=$(( timeout * 2 ))

    # Wait for gamescope's Steam to finish going down first. A second client
    # started while the first still owns the IPC socket never becomes a client:
    # it hands its arguments to the one that is already registered and exits, so
    # starting too early leaves no desktop Steam at all.
    for (( i = 0; i < polls; i++ )); do
        steam_running || break
        sleep 0.5
    done
    # Still there, so a client is already running and there is nothing to
    # restore -- console mode was left without ever stopping this one.
    steam_running && return 0

    local exit_helper
    exit_helper="$(find_helper "$NAME-exit")"

    for (( attempt = 1; attempt <= 2; attempt++ )); do
        # Never fight the next session. Starting console mode stops the desktop
        # client on purpose, so a client started now would be shut down again a
        # moment later, and `stop_steam` would refuse if a game had reached it.
        "$exit_helper" --running && return 0

        say "Bringing the desktop Steam client back…"
        # The second attempt drops the transient scope: if systemd-run could not
        # reach the user manager, nothing started, and plain setsid still works.
        launch_desktop_steam "$(( attempt - 1 ))"

        for (( i = 0; i < polls; i++ )); do
            steam_running && return 0
            "$exit_helper" --running && return 0
            sleep 0.5
        done
    done

    warn "the desktop Steam client did not come back; start Steam yourself."
}

# Going straight back into console mode is the case the relaunch cannot see by
# itself: it watches for a *running* gamescope, and stop_steam happens before
# there is one. Waiting for the lock means the client it is starting is already
# up by the time we look, so stop_steam shuts it down like any other, instead of
# finding nothing and leaving it to appear a moment later beside the Steam
# gamescope is about to start.
await_steam_relaunch() {
    local lock
    lock="$(steam_lock_path)"
    [[ -e "$lock" ]] || return 0
    have flock || return 0
    ( flock -w 30 9 || true ) 9>"$lock" 2>/dev/null || true
}

# Steam drives the controller trackpad through XTEST, and extest reimplements
# those calls against /dev/uinput so a desktop Wayland session does not turn the
# first one into an xdg-desktop-portal "allow remote interaction" prompt.
#
# Off by default, because inside gamescope it is the wrong answer and actively
# breaks the trackpad. gamescope emulates input itself -- it logs "Successfully
# initialized libei for input emulation" -- so XTEST aimed at its XWayland lands
# on its own cursor and the trackpad simply works. extest intercepts those calls
# first and replays them against the *host* seat, in host coordinates, which
# leaves gamescope's cursor untouched and nothing to click. Only turn this on for
# a gamescope too old to emulate input, where the portal prompt appears instead.
extest_available() {
    [[ -e /usr/lib32/libextest.so || -e /usr/lib/libextest.so ]]
}

extest_wanted() {
    is_on "$CFG_TRACKPAD_FIX" && extest_available
}

# Whether gamescope can emulate input, which is what lets the trackpad move its
# cursor without help. Read from the link against libeis rather than from a
# version number, since distributions differ on when the feature arrived.
gamescope_emulates_input() {
    have gamescope || return 1
    local libs
    libs="$(ldd "$(command -v gamescope)" 2>/dev/null || true)"
    [[ "$libs" == *libeis.so* ]]
}

warn_extest() {
    is_on "$CFG_TRACKPAD_FIX" || return 0
    if ! extest_available; then
        warn "TRACKPAD_FIX is on but libextest is not installed."
        warn "install it with: paru -S libextest-git   (or yay -S libextest-git)"
        return 0
    fi
    gamescope_emulates_input || return 0
    warn "TRACKPAD_FIX is on, but this gamescope emulates input itself, so extest"
    warn "will replay the trackpad on the desktop and console mode will have no"
    warn "cursor at all. Set TRACKPAD_FIX=off unless you know you need it."
}

# ---- gamescope ----------------------------------------------------------

# Captured rather than piped into grep -q, which SIGPIPEs getcap and trips
# pipefail on a successful match.
gamescope_has_rt() {
    local caps
    have gamescope || return 1
    caps="$(getcap "$(command -v gamescope)" 2>/dev/null || true)"
    [[ "$caps" == *cap_sys_nice* ]]
}

gamescope_argv() {
    local -n out=$1
    out=(gamescope
         -W "$WIDTH" -H "$HEIGHT"
         -r "$REFRESH"
         --fullscreen
         --steam
         --expose-wayland)

    is_on "$CFG_VRR" && out+=(--adaptive-sync)
    is_on "$CFG_HDR" && out+=(--hdr-enabled)

    # Realtime scheduling silently does nothing without CAP_SYS_NICE, so only
    # ask for it when it will actually be granted.
    gamescope_has_rt && out+=(--rt)

    # Only the SDL backend can target a specific output, and only through
    # XWayland: SDL's Wayland driver cannot position windows, so the compositor
    # would choose the screen instead of us.
        out+=(--backend sdl --display-index "$DISPLAY_INDEX"
              --prefer-output "$CONNECTOR" --force-grab-cursor)

    if [[ -n "$CFG_EXTRA_GAMESCOPE_ARGS" ]]; then
        # Deliberately word-split: this is a list of arguments, not one string.
        # shellcheck disable=SC2206
        local extra=($CFG_EXTRA_GAMESCOPE_ARGS)
        out+=("${extra[@]}")
    fi

    # Steam and games must not inherit the *host* Wayland display. If they do,
    # a Vulkan game (Slay the Spire 2, etc.) creates a swapchain on GNOME/KWin
    # instead of inside gamescope. The WSI layer then shows a GTK dialog on the
    # desktop — and --force-grab-cursor means a controller cannot click OK.
    # Strip WAYLAND_DISPLAY and force toolkit dialogs onto gamescope's X11.
    out+=(-- env -u WAYLAND_DISPLAY
          GDK_BACKEND=x11
          QT_QPA_PLATFORM=xcb)

    # The preload is set on Steam here rather than exported, because gamescope
    # carries CAP_SYS_NICE for realtime scheduling and file capabilities put a
    # process into glibc's secure-execution mode. There LD_PRELOAD is not merely
    # ignored -- glibc strips it from the environment so it cannot reach
    # children -- so exporting it reached neither gamescope nor the Steam it
    # starts, and the trackpad moved nothing at all. Handing it to env, which has
    # no capabilities, sets it on Steam alone, which is the only process that
    # makes XTEST calls anyway.
    extest_wanted && out+=("LD_PRELOAD=${EXTEST_LIB}${LD_PRELOAD:+:$LD_PRELOAD}")

    out+=(steam -gamepadui)
}

start_console() {
    have steam || die "Steam is not installed"
    have gamescope || die "gamescope is not installed — sudo pacman -S gamescope"

    if [[ -z "${DISPLAY_OVERRIDE:-}" ]]; then
        local saved
        saved="$("$HELPER_DISPLAY" saved 2>/dev/null || true)"
        if [[ -z "$saved" || "$saved" == "(none)" ]]; then
            die "no display saved. Open Console Mode Settings and pick one.
It will not choose a screen for you."
        fi
    fi

    resolve_display || die "$RESOLVE_ERROR"
    local argv
    gamescope_argv argv

    if (( DRY_RUN )); then
        say "Would run:"
        say "  ${argv[*]}"
        say "  HDMI audio:"
        "$HELPER_DISPLAY" audio-route --dry-run 2>/dev/null | sed 's/^/    /' || true
        local dry_source
        dry_source="$("$HELPER_DISPLAY" audio-input-resolve 2>/dev/null || true)"
        say "  microphone: ${dry_source:-(session default)}"
        say "  hidden controllers: ${CFG_IGNORE_CONTROLLERS:-(none)}"
        return 0
    fi

    say "Console mode on $CONNECTOR at ${WIDTH}x${HEIGHT}@${REFRESH}Hz."
    warn_extest
    await_steam_relaunch
    stop_steam

    # One GPU HDMI profile is visible at a time. Steam's audio list is that
    # profile plus USB devices, so without this the projector never appears.
    #
    # Installed here, straight after stop_steam, so that whatever happens next
    # -- a session that ran for hours or a gamescope that never came up -- the
    # two things console mode took away are given back: the desktop's HDMI audio
    # profile, and the Steam client. Audio first, so the desktop client does not
    # enumerate its devices while the GPU profile still points at the television.
    back_to_desktop() {
        "$HELPER_DISPLAY" audio-restore || true
        restart_desktop_steam || true
    }
    trap back_to_desktop EXIT
    local route_log sink
    route_log="$("$HELPER_DISPLAY" audio-route 2>&1)" || warn "could not switch HDMI audio to $CONNECTOR"
    say "$route_log"
    sink="$(printf '%s\n' "$route_log" | awk '/^SINK /{print $2; exit}')"
    # Steam and games inherit this, so they play on the TV even if the
    # session default is still a headset.
    [[ -n "$sink" ]] && export PULSE_SINK="$sink"

    # Same idea for the microphone, which voice chat in console mode needs: the
    # desktop default is likely the mic at your desk, not the one by the TV.
    # Only set when saved, and only for what we launch, so the desktop's own
    # default source is never changed.
    local source
    source="$("$HELPER_DISPLAY" audio-input-resolve 2>/dev/null || true)"
    if [[ -n "$source" ]]; then
        export PULSE_SOURCE="$source"
        say "Microphone: $source"
    fi

    # Hide devices that are only nominally gamepads. Anything holding a lower
    # js number than the controller is player one as far as a game is
    # concerned, even if it never sends an event, which leaves the controller
    # driving a second player that cannot reach the menus. Keyboards with an
    # analog mode do this: the endpoint is part of their USB descriptor, so it
    # is there from boot, while Steam Input's virtual pad can only appear once
    # Steam is up. Scoped to console mode, so the device is still a gamepad on
    # the desktop.
    if [[ -n "$CFG_IGNORE_CONTROLLERS" ]]; then
        # Appended: Steam sets this too, to hide the physical controller it is
        # presenting through Steam Input, and replacing its value would undo
        # that.
        if [[ -n "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}" ]]; then
            export SDL_GAMECONTROLLER_IGNORE_DEVICES="${SDL_GAMECONTROLLER_IGNORE_DEVICES},${CFG_IGNORE_CONTROLLERS}"
        else
            export SDL_GAMECONTROLLER_IGNORE_DEVICES="$CFG_IGNORE_CONTROLLERS"
        fi
        say "Hiding controllers: $CFG_IGNORE_CONTROLLERS"
    fi

    # Mesa's device-select layer can sit in front of gamescope's WSI hook and
    # produce a "non-Gamescope swapchain" dialog. Anti-lag is opt-in but if it
    # was enabled in the session it does the same. Neither is needed inside
    # a single-GPU nested session.
    export NODEVICE_SELECT=1
    export DISABLE_LAYER_MESA_ANTI_LAG=1

    export SDL_VIDEODRIVER=x11
    # Not exec: the EXIT trap has to run so the desktop HDMI device comes back.
    # gamescope often forks to gamescope-wl and the parent exits immediately.
    # Wait until that compositor is *up*, then until it is gone — otherwise we
    # restore Odyssey HDMI before Steam starts, and the list shows the monitor.
    local helper_exit gs_pid i
    helper_exit="$(find_helper "$NAME-exit")"
    "${argv[@]}" &
    gs_pid=$!
    for i in $(seq 1 250); do
        if "$helper_exit" --running; then
            "$HELPER_DISPLAY" audio-route >/dev/null || true
            break
        fi
        if ! kill -0 "$gs_pid" 2>/dev/null; then
            sleep 0.6
            "$helper_exit" --running && break
            warn "gamescope exited before console mode came up"
            break
        fi
        sleep 0.1
    done
    wait "$gs_pid" || true
    while "$helper_exit" --running; do
        sleep 0.4
    done
}

# ---- setup --------------------------------------------------------------

write_config() {
    mkdir -p "$CONFIG_DIR"
    cat > "$CONFIG_FILE" <<EOF
# cachy-console configuration
# Written by 'cachy-console setup'; safe to edit by hand.

# Which display console mode runs on. A connector name (HDMI-1, DP-2).
# Not "auto": if this display is off, console mode waits rather than using
# another screen. Change it with: cachy-console settings
DISPLAY=$CFG_DISPLAY

# Resolution and refresh rate. "auto" follows whatever that display is already
# set to in your desktop's display settings, which is almost always what you
# want. Override with e.g. RESOLUTION=1920x1080 and REFRESH=120.
RESOLUTION=$CFG_RESOLUTION
REFRESH=$CFG_REFRESH

# Variable refresh rate (FreeSync/G-Sync) inside console mode.
VRR=$CFG_VRR

# HDR. Only worth turning on if the display and your games support it.
HDR=$CFG_HDR

# Preload extest so Steam's trackpad XTEST calls become uinput events, which a
# desktop Wayland session needs to avoid an "allow remote interaction" prompt.
# Leave this off: gamescope emulates input itself, so the trackpad already moves
# its cursor, and extest would replay the calls on the desktop instead -- no
# cursor in console mode at all. Only for a gamescope too old to emulate input.
TRACKPAD_FIX=$CFG_TRACKPAD_FIX

# Start the ordinary desktop Steam client again when console mode ends. Leaving
# takes gamescope's Steam down with it, and the Steam button cannot open Big
# Picture with no client running, so this is what makes a second press work.
# It comes back minimised to the tray, on the desktop's own audio devices.
RESTART_STEAM=$CFG_RESTART_STEAM

# Open console mode when you press the Steam button twice on a controller.
# Read by cachy-console-watch.service.
STEAM_BUTTON=on

# With two or more games running, mute every game except the one you are
# looking at. Read by cachy-console-audio.service.
AUDIO_FOCUS=on

# Never mute these, even though Steam started them. Comma separated names or
# appids. Voice chat belongs here: Discord launched from the library is a Steam
# shortcut like any other, so without this it counts as a game and goes quiet
# whenever you look at the one you are playing.
# An appid works as well as a name, and is worth adding for an Electron app
# like Discord whose audio process is not reliably named after the app.
# Read by cachy-console-audio.service; restart it after changing this.
AUDIO_NEVER_MUTE=Discord

# Hold the streams named above on the devices below, moving them if they end up
# elsewhere. Discord keeps its own output and input choice, so without this it
# only starts on the right device and its own settings win afterwards. Moving
# the stream is the one thing an application cannot overrule.
# Read by cachy-console-audio.service; restart it after changing this.
AUDIO_PIN_VOICE=on

# Audio output inside console mode. An HDMI monitor name (Optoma UHD) or
# a device name (RODECaster Duo). Empty follows the saved display.
# Change it with: cachy-console settings
AUDIO_DEVICE=$CFG_AUDIO_DEVICE

# Microphone inside console mode, for voice chat from the couch. A device name
# (HyperX Cloud III S Wireless). Empty leaves input alone, so whatever your
# desktop uses is what console mode uses.
# Change it with: cachy-console settings
AUDIO_INPUT_DEVICE=$CFG_AUDIO_INPUT_DEVICE

# Devices console mode should not treat as gamepads, as "0xVENDOR/0xPRODUCT",
# comma separated. For a keyboard with an analog gamepad mode, which takes the
# first controller slot at boot and so becomes player one ahead of the
# controller. Empty hides nothing. They stay gamepads on the desktop.
# List them with: cachy-console controllers
IGNORE_CONTROLLERS=$CFG_IGNORE_CONTROLLERS

# Extra arguments passed straight to gamescope, for anything not covered above.
# For example: EXTRA_GAMESCOPE_ARGS=--mangoapp
EXTRA_GAMESCOPE_ARGS=$CFG_EXTRA_GAMESCOPE_ARGS
EOF
    say "Saved $CONFIG_FILE"
}

setup() {
    say "== $NAME setup =="
    say
    say "Displays detected:"
    "$HELPER_DISPLAY" list --no-hint
    say

    local -a connectors=()
    mapfile -t connectors < <("$HELPER_DISPLAY" list --json |
        python3 -c 'import json,sys; [print(d["connector"]) for d in json.load(sys.stdin)]')
    (( ${#connectors[@]} )) || die "no displays detected"

    if (( ${#connectors[@]} == 1 )); then
        CFG_DISPLAY="${connectors[0]}"
        say "Only one display (${connectors[0]}), so console mode will use it."
    else
        local reply
        read -rp "Which display should console mode use? [number] " reply
        if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply < ${#connectors[@]} )); then
            CFG_DISPLAY="${connectors[$reply]}"
        else
            die "not one of the numbers listed: $reply
Pick a display; console mode will not choose one by itself."
        fi
        say "Console mode will use: $CFG_DISPLAY"
    fi

    local reply
    read -rp "Enable variable refresh rate (FreeSync/G-Sync)? [Y/n] " reply
    [[ "${reply,,}" == n* ]] && CFG_VRR=off || CFG_VRR=on

    read -rp "Enable HDR? Only if your display and games support it. [y/N] " reply
    [[ "${reply,,}" == y* ]] && CFG_HDR=on || CFG_HDR=off

    write_config
    say
    say "Done. Start console mode with:  $NAME"
    say "Check everything with:          $NAME status"
}

# ---- status -------------------------------------------------------------

status() {
    local problems=0 warnings=0

    say "== system =="
    printf '  %-20s %s\n' "session" "${XDG_SESSION_TYPE:-unknown}"
    printf '  %-20s %s\n' "desktop" "${XDG_CURRENT_DESKTOP:-unknown}"
    printf '  %-20s %s\n' "config" \
        "$([[ -r "$CONFIG_FILE" ]] && echo "$CONFIG_FILE" || echo "none yet (run: $NAME setup)")"

    local bin
    for bin in steam gamescope python3; do
        if have "$bin"; then
            printf '  %-20s %s\n' "$bin" "$(command -v "$bin")"
        else
            printf '  %-20s %s\n' "$bin" "MISSING"
            problems=$(( problems + 1 ))
        fi
    done

    if have gamescope; then
        if gamescope_has_rt; then
            printf '  %-20s %s\n' "gamescope --rt" "available"
        else
            printf '  %-20s %s\n' "gamescope --rt" "unavailable"
            say "     gamescope cannot use realtime scheduling without CAP_SYS_NICE,"
            say "     which costs you frame pacing under load. Grant it with:"
            say "       sudo setcap CAP_SYS_NICE=eip $(command -v gamescope)"
            warnings=$(( warnings + 1 ))
        fi
    fi

    # The services read X11 window properties, so they need DISPLAY and
    # XAUTHORITY in the *systemd user manager's* environment, which is separate
    # from this shell's. Desktops are supposed to import them at login; when one
    # does not, the watcher simply never reacts to the Steam button, and the
    # only clue is a line in its journal. Say so here instead.
    local sd_env
    sd_env="$(systemctl --user show-environment 2>/dev/null || true)"
    if [[ "$sd_env" == *DISPLAY=* && "$sd_env" == *XAUTHORITY=* ]]; then
        printf '  %-20s %s\n' "service environment" "ok"
    else
        printf '  %-20s %s\n' "service environment" "INCOMPLETE"
        say "     systemd's user session is missing DISPLAY or XAUTHORITY."
        say "     That is common on Plasma; the session wrapper and autostart"
        say "     fill it in. If the Steam button still does nothing, run:"
        say "       systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XAUTHORITY"
        warnings=$(( warnings + 1 ))
    fi

    say
    say "== displays =="
    if ! "$HELPER_DISPLAY" list; then
        warn "could not enumerate displays"
        problems=$(( problems + 1 ))
    fi

    say
    say "== trackpad =="
    if gamescope_emulates_input; then
        say "  gamescope emulates input, so it moves the trackpad cursor itself."
    else
        say "  this gamescope does not emulate input (no libeis), so the trackpad"
        say "  needs TRACKPAD_FIX=on to move a cursor."
    fi
    if is_on "$CFG_TRACKPAD_FIX"; then
        if ! extest_available; then
            warn "TRACKPAD_FIX is on but libextest is not installed."
            say "       paru -S libextest-git"
            warnings=$(( warnings + 1 ))
        elif gamescope_emulates_input; then
            warn "TRACKPAD_FIX is on while gamescope emulates input. extest replays"
            warn "the trackpad on the desktop instead, so console mode gets no"
            warn "cursor. Set TRACKPAD_FIX=off."
            warnings=$(( warnings + 1 ))
        fi
        # A bare soname resolves through the linker cache. Captured rather than
        # piped into grep -q, which SIGPIPEs ldconfig and trips pipefail.
        local cache
        cache="$(ldconfig -p 2>/dev/null || true)"
        if extest_available && [[ "$EXTEST_LIB" != /* && "$cache" != *"$EXTEST_LIB"* ]]; then
            warn "$EXTEST_LIB is not in the linker cache; run: sudo ldconfig"
            warnings=$(( warnings + 1 ))
        fi
        if [[ ! -w /dev/uinput ]]; then
            warn "/dev/uinput is not writable, so extest cannot inject input."
            warnings=$(( warnings + 1 ))
        fi
    else
        say "  TRACKPAD_FIX is off."
    fi

    say
    say "== services =="
    local unit enabled active
    for unit in "$NAME-watch" "$NAME-audio"; do
        if systemctl --user list-unit-files "$unit.service" >/dev/null 2>&1 &&
           [[ -n "$(systemctl --user list-unit-files "$unit.service" --no-legend 2>/dev/null)" ]]; then
            # `|| true` rather than `|| echo inactive`: both of these print the
            # state and *also* exit non-zero for anything but enabled and active,
            # so a fallback that echoed appended a second copy and split the line
            # in two. The status still has to be swallowed, or set -e takes the
            # whole report down at the first service that is not running.
            enabled="$(systemctl --user is-enabled "$unit.service" 2>/dev/null)" || true
            active="$(systemctl --user is-active "$unit.service" 2>/dev/null)" || true
            printf '  %-24s %s / %s\n' "$unit" "${enabled:-unknown}" "${active:-unknown}"
            # Enabled but not running is the state worth spelling out. It looks
            # like everything is set up, and the symptoms point somewhere else
            # entirely: the Steam button opens Big Picture on the desktop and on
            # the wrong screen, games talk over each other, and none of it
            # mentions a service.
            #
            # 78 is how the services say they were turned off in the config, so
            # that reads as the setting it is rather than as a fault.
            if [[ "$enabled" == enabled && "$active" != active ]] &&
               [[ "$(systemctl --user show "$unit.service" -p ExecMainStatus --value 2>/dev/null)" == 78 ]]; then
                say "      off in your config, which is why it is not running."
            elif [[ "$enabled" == enabled && "$active" != active ]]; then
                case "$unit" in
                    "$NAME-watch")
                        say "      not running, so the Steam button opens Big Picture on the"
                        say "      desktop instead of console mode. Start it with:"
                        say "        systemctl --user start $unit" ;;
                    "$NAME-audio")
                        say "      not running, so nothing mutes background games or holds"
                        say "      voice chat on console mode's devices. Start it with:"
                        say "        systemctl --user start $unit" ;;
                esac
            fi
        else
            printf '  %-24s %s\n' "$unit" "not installed"
        fi
    done

    say
    say "== steam =="
    if steam_running; then
        say "  running; it will be restarted into console mode."
    else
        say "  not running."
    fi
    if is_on "$CFG_RESTART_STEAM"; then
        say "  the desktop client comes back when console mode ends, so the"
        say "  Steam button can open Big Picture again (RESTART_STEAM=on)."
    else
        say "  RESTART_STEAM is off, so leaving console mode leaves no Steam"
        say "  running and the Steam button will have nothing to open."
    fi
    if game_running; then
        warn "a game is running (AppID: $(running_appids)); starting console mode"
        warn "now would refuse, because restarting Steam would close it."
        warnings=$(( warnings + 1 ))
    fi

    say
    say "== HDMI audio =="
    "$HELPER_DISPLAY" audio-list || true

    say
    say "== microphone =="
    "$HELPER_DISPLAY" audio-input-list || true

    say
    say "== controllers =="
    "$HELPER_DISPLAY" controllers || true

    say
    say "== what would run =="
    if ! have gamescope; then
        say "  gamescope is missing, so nothing can run yet."
    elif resolve_display; then
        local argv
        gamescope_argv argv
        say "  display: $CONNECTOR (gamescope index $DISPLAY_INDEX) at ${WIDTH}x${HEIGHT}@${REFRESH}Hz"
        say "  ${argv[*]}"
    else
        warn "${RESOLVE_ERROR:-cannot resolve the configured display}"
        say "  is it plugged in and switched on? see: $NAME displays"
        problems=$(( problems + 1 ))
    fi

    say
    if (( problems )); then
        say "$problems problem(s), $warnings warning(s)."
        return 1
    fi
    say "No problems. $warnings warning(s)."
}

# ---- main ---------------------------------------------------------------

COMMAND=start
ARGS=()

while (( $# )); do
    case "$1" in
        -h|--help|help)     usage ;;
        start|setup|settings|status|check|displays|controllers|exit|stop|shortcut|restart-steam)
                            COMMAND="$1" ;;
        --display)          DISPLAY_OVERRIDE="${2-}"; shift ;;
        --display=*)        DISPLAY_OVERRIDE="${1#*=}" ;;
        # Also forwarded: `shortcut --dry-run` would otherwise write for real.
        --dry-run)          DRY_RUN=1; ARGS+=("$1") ;;
        *)                  ARGS+=("$1") ;;
    esac
    shift
done

load_config
HELPER_DISPLAY="$(find_helper "$NAME-display")"

case "$COMMAND" in
    start)      start_console ;;
    setup)      setup ;;
    settings)   exec "$(find_helper "$NAME-settings")" ;;
    status|check) status ;;
    displays)   "$HELPER_DISPLAY" list ;;
    controllers) "$HELPER_DISPLAY" controllers ;;
    exit|stop)  exec "$(find_helper "$NAME-exit")" ;;
    shortcut)   exec "$(find_helper "$NAME-shortcut")" "${ARGS[@]+"${ARGS[@]}"}" ;;
    # How cachy-console-watch puts the client back when it, and not this
    # script, is the one left alive after a session.
    restart-steam) restart_desktop_steam ;;
esac
