#!/usr/bin/env bash
# cachy-console-exit — leave console mode and go back to the desktop.
#
# Steam will not let you out on its own. It hides "Exit Steam", "Exit Big
# Picture Mode" and "Minimize" whenever it detects gamescope, because SteamOS
# expects a session manager to handle that, and Big Picture's "Switch to
# Desktop" calls a SteamOS-only method that a normal Linux client answers with
# "not implemented". So this is the way out.
#
# Three ways to run it:
#   cachy-console exit                 from a terminal
#   the "Exit Console Mode" entry      from inside Big Picture, with a
#   in your Steam library              controller
#   a keyboard shortcut                bound to this command
#
# It ends console mode by asking Steam to shut down. Steam is gamescope's primary
# child, so gamescope follows it out on its own, and Steam gets to save what it
# was doing instead of dying mid-write. Signalling gamescope is still here as a
# fallback, because a Steam busy with a running game does not always answer, but
# it is no longer the first thing tried: gamescope sat on SIGTERM for the whole
# grace period and then had to be killed, which took ten seconds the user spent
# looking at a screen that had not changed, and left Steam convinced it had
# crashed. cachy-console then restarts the ordinary desktop client so the Steam
# button works again.
#
# With no session to end it closes Big Picture instead, because the Steam button
# opens Big Picture on the desktop whenever the watcher is not running to turn it
# into one, and this tile is in the same library either way.
#
#   cachy-console-exit           stop the session
#   cachy-console-exit --running exit 0 if a console session is up
set -euo pipefail

# How long Steam gets to close itself before gamescope is signalled. It takes a
# couple of seconds in practice; the rest is headroom for a slow shutdown. Both
# waits are overridable so the tests need not sit through them.
QUIT="${CACHY_CONSOLE_QUIT:-8}"
GRACE="${CACHY_CONSOLE_GRACE:-10}"
TAG="cachy-console-exit"

# Where to look for running processes. Only the tests set this; they have no way
# to put a gamescope into the real /proc.
PROC="${CACHY_CONSOLE_PROC:-/proc}"

log() { printf '%s: %s\n' "$TAG" "$*" >&2; }

# gamescope runs under the name gamescope-wl, which is why `pgrep -x gamescope`
# finds nothing while a session is plainly running.
is_gamescope() {
    local comm
    comm="$(cat "$PROC/$1/comm" 2>/dev/null)" || return 1
    [[ "$comm" == gamescope || "$comm" == gamescope-wl ]]
}

# An exited-but-unreaped gamescope keeps its /proc entry and its name, so
# without this check a dead session still looks alive.
is_zombie() {
    local line
    while read -r line; do
        [[ "$line" == State:* ]] || continue
        [[ "$line" == *Z* ]] && return 0 || return 1
    done 2>/dev/null < "$PROC/$1/status"
    return 1
}

alive_gamescope() {
    is_gamescope "$1" && ! is_zombie "$1"
}

is_console_cmdline() {
    # Console mode is the gamescope that launched Steam Big Picture.
    # gamescopereaper's cmdline also mentions steam -gamepadui, but its
    # comm is not gamescope, so it never reaches this check.
    local cmd=$1
    [[ "$cmd" == *gamepadui* || "$cmd" == *" --steam "* || "$cmd" == *"--steam" ]]
}

cmdline_of() {
    tr '\0' ' ' < "$PROC/$1/cmdline" 2>/dev/null || true
}

console_gamescope_pids() {
    local pid comm cmd
    for pid in "$PROC"/[0-9]*; do
        pid="${pid##*/}"
        [[ "$pid" == *[0-9]* && "$pid" != *[^0-9]* ]] || continue
        alive_gamescope "$pid" || continue
        cmd="$(cmdline_of "$pid")"
        is_console_cmdline "$cmd" || continue
        printf '%s\n' "$pid"
    done
}

ppid_of() {
    local line
    while read -r line; do
        if [[ "$line" == PPid:* ]]; then
            printf '%s\n' "${line#PPid:}" | tr -d '[:space:]'
            return 0
        fi
    done 2>/dev/null < "$PROC/$1/status"
    return 1
}

# Walking our own ancestry first means that when this runs from inside the
# session -- as the library shortcut does -- we end that session and not some
# other gamescope the user happens to be running.
find_ancestor() {
    local pid=$$ hops=0
    while [[ -n "$pid" && "$pid" -gt 1 && "$hops" -lt 40 ]]; do
        if alive_gamescope "$pid"; then
            printf '%s\n' "$pid"
            return 0
        fi
        pid="$(ppid_of "$pid")" || return 1
        hops=$(( hops + 1 ))
    done
    return 1
}

steam_running() { pgrep -x steam >/dev/null 2>&1; }

stop_pid() {
    local pid=$1
    log "leaving console mode (gamescope pid $pid)"
    # Detached on purpose: when this runs from inside the session, gamescope's
    # reaper takes down our process group as soon as it starts shutting down, so
    # the signal has to come from something that outlives us. Steam also
    # expects the thing it launched to return promptly.
    setsid bash -c '
        pid=$1 quit=$2 grace=$3
        # Long enough for the tile to have returned, so Steam is not asked to
        # close while it still counts us as a running game.
        sleep 0.4
        kill -0 "$pid" 2>/dev/null || exit 0

        # The polite way out, and the quick one. gamescope stops when its primary
        # child does, so closing Steam closes the session.
        if command -v steam >/dev/null 2>&1; then
            steam -shutdown >/dev/null 2>&1 &
            for _ in $(seq "$quit"); do
                kill -0 "$pid" 2>/dev/null || exit 0
                sleep 1
            done
        fi

        kill -TERM "$pid" 2>/dev/null || exit 0
        for _ in $(seq "$grace"); do
            kill -0 "$pid" 2>/dev/null || exit 0
            sleep 1
        done
        kill -KILL "$pid" 2>/dev/null || true
    ' _ "$pid" "$QUIT" "$GRACE" >/dev/null 2>&1 < /dev/null &
}

# Steam's own way back to the desktop client. Detached for the same reason as
# stop_pid: Steam is running this tile, and we are asking Steam to change what it
# is showing, which it does by tearing down the window our caller came from.
leave_big_picture() {
    log "no console session; asking Steam to leave Big Picture."
    setsid steam steam://close/bigpicture >/dev/null 2>&1 < /dev/null &
}

if [[ "${1-}" == --running ]]; then
    [[ -n "$(console_gamescope_pids)" ]]
    exit $?
fi

if [[ "${1-}" == -h || "${1-}" == --help ]]; then
    sed -n '2,31p' "$0" | sed 's/^# \?//'
    exit 0
fi

targets=()
if ancestor="$(find_ancestor)"; then
    targets=("$ancestor")
else
    mapfile -t targets < <(console_gamescope_pids)
fi
if (( ${#targets[@]} == 0 )) || [[ -z "${targets[0]:-}" ]]; then
    # Only with a client already up. Any steam:// URL starts Steam if it has to,
    # and an exit that launches Steam is the opposite of what was asked for.
    if steam_running; then
        leave_big_picture
    else
        log "console mode is not running; nothing to do."
    fi
    exit 0
fi

for target in "${targets[@]}"; do
    [[ -n "$target" ]] && stop_pid "$target"
done
exit 0
