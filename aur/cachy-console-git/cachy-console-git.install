post_install() {
    echo
    echo "  cachy-console is installed. Finish the per-user setup with:"
    echo
    echo "    cachy-console first-run"
    echo
    echo "  That enables the Steam-button and audio services, picks a display"
    echo "  if you have not already, and queues Discord / Spotify tiles"
    echo "  so they are written the next time Steam is not running."
    echo
    echo "  After a kernel update, controllers you plug in are not detected"
    echo "  until you restart (cachy-console asks you to). To keep them working"
    echo "  until then:"
    echo
    echo "    sudo pacman -S kernel-modules-hook"
    echo "    sudo systemctl enable linux-modules-cleanup.service"
    echo "  If you used ./install.sh before, first-run removes those home"
    echo "  copies so /usr is what runs."
    echo
    echo "  Some games ignore a controller because of their own input code"
    echo "  (Assassin's Creed). Console mode applies the known fixes for"
    echo "  installed games when it starts; see them with:"
    echo
    echo "    cachy-console compat"
    echo
}

post_upgrade() {
    echo
    echo "  Restart the user services so they pick up the new files:"
    echo
    echo "    systemctl --user daemon-reload"
    echo "    systemctl --user try-restart cachy-console-watch.service cachy-console-audio.service"
    echo
}

post_remove() {
    echo
    echo "  Config is left in ~/.config/cachy-console. Remove it if you want."
    echo "  Steam library tiles (Discord, Spotify) are yours to delete."
    echo "  Game fixes from cachy-console compat (Assassin's Creed's EaglePatch)"
    echo "  stay in those games' folders so they keep working with a controller."
    echo "  To take one out, run before removing: cachy-console compat remove APPID"
    echo
}
